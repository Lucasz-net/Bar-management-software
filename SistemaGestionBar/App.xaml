<Application x:Class="SistemaGestionBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
             xmlns:views="clr-namespace:SistemaGestionBar.Views"
             xmlns:vmAdmin="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             xmlns:viewsAdmin="clr-namespace:SistemaGestionBar.Views.Admin"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Cyan" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/Generic.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PasswordBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.RadioButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />

                <ResourceDictionary Source="Views/Admin/EstilosAdmin.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Azul del sistema (estilo Apple) en lugar del cian de Material. -->
            <Color x:Key="MaterialDesign.Color.Primary">#0071E3</Color>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#0071E3" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#0071E3" />
            <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#0071E3" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="#0071E3" />

            <FontFamily x:Key="MaterialDesignFont">/SistemaGestionBar;component/Assets/Fonts/#Inter</FontFamily>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="/SistemaGestionBar;component/Assets/Fonts/#Inter" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PuntoDeVentaViewModel}">
                <views:PuntoDeVentaView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmAdmin:AdminViewModel}">
                <viewsAdmin:AdminView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmAdmin:AdminResumenViewModel}">
                <viewsAdmin:AdminResumenView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:GestionViewModel}">
                <viewsAdmin:GestionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:EquipoViewModel}">
                <viewsAdmin:EquipoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminProductosViewModel}">
                <viewsAdmin:AdminProductosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminInventarioViewModel}">
                <viewsAdmin:AdminInventarioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminPersonalViewModel}">
                <viewsAdmin:AdminPersonalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminUsuariosViewModel}">
                <viewsAdmin:AdminUsuariosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminVentasViewModel}">
                <viewsAdmin:AdminVentasView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminReportesViewModel}">
                <viewsAdmin:AdminReportesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminParametrosViewModel}">
                <viewsAdmin:AdminParametrosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmAdmin:AdminBackupsViewModel}">
                <viewsAdmin:AdminBackupsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
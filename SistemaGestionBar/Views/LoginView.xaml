<UserControl x:Class="SistemaGestionBar.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="clr-namespace:SistemaGestionBar.Behaviors"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             d:DesignHeight="820"
             d:DesignWidth="1360">

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding IngresarCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>

        <!-- ============================================================
             El login usa el mismo lenguaje visual que el tablero y el punto
             de venta: azul #12305C para la marca, acento #1565C0, fondo
             #F4F6FA y tarjetas blancas con sombra tenida de azul. Antes era
             una tarjeta gris suelta en el medio y parecia de otra aplicacion.
             ============================================================ -->

        <SolidColorBrush x:Key="TintaLogin" Color="#2B3445" />
        <SolidColorBrush x:Key="TintaLoginSuave" Color="#8A93A5" />
        <SolidColorBrush x:Key="AcentoLogin" Color="#1565C0" />

        <!-- Sin Height fijo: el estilo Outlined de Material mide su propio alto para
             ubicar el hint, y forzarselo recorta el texto. Se agranda con Padding. -->
        <Style x:Key="CampoLogin" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="10" />
        </Style>

        <Style x:Key="ClaveLogin" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="10" />
        </Style>

        <Style x:Key="EtiquetaLogin" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TintaLoginSuave}" />
            <Setter Property="Margin" Value="2,0,0,7" />
        </Style>

        <Style x:Key="BotonEntrar" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AcentoLogin}" />
            <Setter Property="BorderBrush" Value="{StaticResource AcentoLogin}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Una fila de lo que el sistema hace, en el panel de marca. -->
        <Style x:Key="TextoCapacidad" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#C3D8F5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>

        <Style x:Key="ChipCapacidad" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#1E4C86" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="560" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             PANEL DE MARCA
             Ocupa la mitad izquierda para que la pantalla de entrada diga
             de que sistema se trata, en vez de ser un cuadro de dos campos
             flotando sobre un fondo gris.
             ============================================================ -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E2A52" Offset="0" />
                    <GradientStop Color="#17427C" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Dos halos que le dan profundidad al plano sin competir con el texto.
                 Van con degradado radial hasta transparente y no con un relleno liso:
                 un circulo de color parejo, por poca opacidad que tenga, deja el borde
                 marcado y se lee como una mancha, no como luz. -->
            <Ellipse Width="620" Height="620"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-260,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2E5FA8FF" Offset="0" />
                        <GradientStop Color="#005FA8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="520" Height="520"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-190,-180">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#245FA8FF" Offset="0" />
                        <GradientStop Color="#005FA8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="440" Margin="48,0">

                <!-- Marca, igual que el encabezado del menu lateral del tablero -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1E4C86" CornerRadius="13" Width="52" Height="52">
                        <materialDesign:PackIcon Kind="GlassCocktail" Width="28" Height="28"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="Sistema de Gestión de Bar" FontSize="16" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Ventas, stock y administración" FontSize="12.5"
                                   Foreground="#7FA6DA" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="#1E4C86" Margin="0,34,0,0" />

                <StackPanel Margin="0,34,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Border Style="{StaticResource ChipCapacidad}">
                            <materialDesign:PackIcon Kind="CashRegister" Width="19" Height="19" Foreground="#9FC6FF"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource TextoCapacidad}" Width="330"
                                   Text="Cobrá en el punto de venta y emití la factura" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Border Style="{StaticResource ChipCapacidad}">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="19" Height="19" Foreground="#9FC6FF"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource TextoCapacidad}" Width="330"
                                   Text="Seguí el stock de insumos y las recetas" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ChipCapacidad}">
                            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="19" Height="19" Foreground="#9FC6FF"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{StaticResource TextoCapacidad}" Width="330"
                                   Text="Mirá las ventas del día y llevate el reporte en PDF" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             FORMULARIO
             ============================================================ -->
        <Grid Grid.Column="1" Background="#F4F6FA">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="16" Padding="34,32">
                <Border.Effect>
                    <DropShadowEffect Color="#1565C0" Opacity="0.13" BlurRadius="28"
                                      ShadowDepth="5" Direction="270" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Iniciar sesión" FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource TintaLogin}" />

                    <!-- Barra de estado: verde al entrar, roja si las credenciales no
                         sirven. Como bloque y no como texto suelto, para que se vea. -->
                    <Border CornerRadius="10" Padding="13,11" Margin="0,20,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="#E4F3EA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayMensaje}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                        <Setter Property="Background" Value="#FBE9E7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,0,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="CheckCircleOutline" />
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>

                            <TextBlock Text="{Binding Mensaje}" FontSize="13" TextWrapping="Wrap"
                                       Width="278" Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#17703F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                                <Setter Property="Foreground" Value="#A93226" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CORREO DE TRABAJO" Style="{StaticResource EtiquetaLogin}" Margin="2,24,0,7" />
                    <TextBox x:Name="CampoCorreo" Style="{StaticResource CampoLogin}"
                             materialDesign:HintAssist.Hint="nombre@bar.com"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="EmailOutline"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="CONTRASEÑA" Style="{StaticResource EtiquetaLogin}" Margin="2,18,0,7" />
                    <PasswordBox Style="{StaticResource ClaveLogin}" PasswordChar="●"
                                 materialDesign:HintAssist.Hint="Tu contraseña"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                                 b:PasswordBoxAssist.Enlazar="True"
                                 b:PasswordBoxAssist.Password="{Binding Clave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Style="{StaticResource BotonEntrar}" Margin="0,24,0,0"
                            Command="{Binding IngresarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LoginVariant" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Entrar" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Aca iba el enlace "Registrarse". No esta ni se reemplaza por un
                         cartel que explique su ausencia: en este sistema nadie se da de
                         alta solo, las cuentas las crea el administrador (RF-09), y una
                         pantalla de ingreso no tiene por que contar eso. -->
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

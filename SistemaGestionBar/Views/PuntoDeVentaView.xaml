<UserControl x:Class="SistemaGestionBar.Views.PuntoDeVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PuntoDeVentaViewModel}"
             d:DesignHeight="820"
             d:DesignWidth="1360"
             Background="#F4F6FA">

    <UserControl.Resources>

        <!-- ============ TARJETA DE PRODUCTO ============ -->
        <Style x:Key="TarjetaProducto" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#E4E8F0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="272" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <!-- Producto ya cargado en el ticket -->
                <DataTrigger Binding="{Binding EstaEnTicket}" Value="True">
                    <Setter Property="BorderBrush" Value="#2E7D32" />
                    <Setter Property="BorderThickness" Value="2.5" />
                </DataTrigger>
                <!-- Sin stock: no se puede vender -->
                <DataTrigger Binding="{Binding SinStock}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="No" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ TARJETA DE CATEGORIA ============ -->
        <Style x:Key="TarjetaCategoria" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E4E8F0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Background" Value="#1565C0" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TituloCategoria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2B3445" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtituloCategoria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A93A5" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Foreground" Value="#BBDEFB" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ BOTONES REDONDOS DE LA TARJETA ============ -->
        <!-- BasedOn exige StaticResource (no admite DynamicResource): se apoya en el
             template Material para que ButtonAssist.CornerRadius tenga efecto. -->
        <Style x:Key="BotonAgregar" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#2D89EF" />
            <Setter Property="BorderBrush" Value="#2D89EF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>

        <Style x:Key="BotonQuitar" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#ECEFF4" />
            <Setter Property="BorderBrush" Value="#ECEFF4" />
            <Setter Property="Foreground" Value="#5A6577" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>

        <!-- ============ ETIQUETAS DE FORMULARIO DEL TICKET ============ -->
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8A93A5" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             COLUMNA IZQUIERDA: catalogo
             ============================================================ -->
        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== ENCABEZADO ==== -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="20,14">
                <Border.Effect>
                    <DropShadowEffect Color="#1565C0" Opacity="0.10" BlurRadius="22" ShadowDepth="4" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Marca + fecha -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#E3F0FE" CornerRadius="12" Width="44" Height="44">
                            <materialDesign:PackIcon Kind="GlassCocktail"
                                                     Width="24" Height="24"
                                                     Foreground="#1565C0"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="PUNTO DE VENTA" FontWeight="Bold" FontSize="15" Foreground="#1565C0" />
                            <TextBlock Text="{Binding FechaActual}" FontSize="12" Foreground="#8A93A5" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Indicadores del dia + alertas de stock (RF-08) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,18,0">

                        <Border Background="#F4F6FA" CornerRadius="12" Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="{Binding TextoVentasDelDia}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#5A6577" />
                        </Border>

                        <Border Background="#FFF3E0"
                                CornerRadius="12"
                                Padding="14,8"
                                ToolTip="Insumos que llegaron al stock mínimo">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayAlertasStock}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOutline"
                                                         Width="16" Height="16"
                                                         Foreground="#E65100"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TextoAlertas}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Usuario + cerrar sesion (RF-09) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1565C0" CornerRadius="18" Width="36" Height="36">
                            <TextBlock Text="{Binding InicialesUsuario}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock Text="{Binding NombreUsuario}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3445" />
                            <TextBlock Text="{Binding RolUsuario}" FontSize="11" Foreground="#8A93A5" />
                        </StackPanel>
                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding CerrarSesionCommand}"
                                ToolTip="Cerrar sesión"
                                Foreground="#8A93A5"
                                Width="36" Height="36">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==== BUSCADOR ==== -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="14"
                    Padding="16,4"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0"
                                             Kind="Magnify"
                                             Width="20" Height="20"
                                             Foreground="#9AA3B2"
                                             VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Style="{DynamicResource MaterialDesignTextBox}"
                             materialDesign:HintAssist.Hint="Buscar producto por nombre o descripción"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             BorderThickness="0"
                             FontSize="14"
                             Margin="10,8"
                             VerticalContentAlignment="Center"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </Grid>
            </Border>

            <!-- ==== CATEGORIAS ==== -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Categorias}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource TarjetaCategoria}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction
                                        Command="{Binding DataContext.SeleccionarCategoriaCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" Style="{DynamicResource TituloCategoria}" />
                                <TextBlock Text="{Binding TextoCantidad}" Style="{DynamicResource SubtituloCategoria}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3"
                       Text="Un clic en la tarjeta agrega el producto al ticket."
                       FontSize="11"
                       Foreground="#9AA3B2"
                       Margin="2,14,0,10" />

            <!-- ==== CATALOGO ==== -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding VistaProductos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource TarjetaProducto}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1565C0" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270" />
                                </Border.Effect>

                                <!-- UX: clic en la tarjeta = agregar al ticket.
                                     El comando vive en el ViewModel de la pantalla, por eso
                                     subimos por RelativeSource hasta el UserControl. -->
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction
                                            Command="{Binding DataContext.AgregarProductoCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Fila 0: foto del producto, con chips superpuestos -->
                                    <Grid Grid.Row="0" Height="104">

                                        <!-- Respaldo para productos sin foto cargada -->
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#DCE7F7" Offset="0" />
                                                    <GradientStop Color="#B9CFEC" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Iniciales}"
                                                       Foreground="#1565C0"
                                                       FontWeight="Bold"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Foto. ImageBrush en vez de <Image> porque un Border
                                             no recorta a sus hijos segun CornerRadius, pero si
                                             recorta su propio Background. -->
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding RutaImagen}" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneImagen}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Chip de stock -->
                                        <Border CornerRadius="8"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D9FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Background" Value="#F2E65100" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                            <Setter Property="Background" Value="#F2C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TextoStock}"
                                                       FontSize="10"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#4A5568" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- RF-04: solo aparece si el producto tiene receta cargada -->
                                        <Button Width="30" Height="30"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Foreground="#7B5BD6"
                                                Background="#E6FFFFFF"
                                                ToolTip="Ver receta"
                                                Command="{Binding DataContext.VerRecetaCommand,
                                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneReceta}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="BookOpenVariant" Width="17" Height="17" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Nombre}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#2B3445"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Descripcion}"
                                               FontSize="11"
                                               Foreground="#9AA3B2"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />

                                    <!-- Fila 3: precio y controles de cantidad -->
                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Precio, StringFormat={}{0:C0}}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="#2E7D32"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CantidadEnTicket}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#2B3445"
                                                       MinWidth="18"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEnTicket}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Style="{DynamicResource BotonAgregar}"
                                                    ToolTip="Agregar al ticket"
                                                    Command="{Binding DataContext.AgregarProductoCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================
             COLUMNA DERECHA: ticket de la venta
             ============================================================ -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="18"
                Margin="0,20,20,20"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#1565C0" Opacity="0.12" BlurRadius="26" ShadowDepth="5" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ==== Titulo ==== -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Ticket actual" FontSize="17" FontWeight="Bold" Foreground="#2B3445" />
                    <Border Background="#E3F0FE" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CantidadUnidades, StringFormat={}{0} u.}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1565C0" />
                    </Border>
                </Grid>

                <!-- ==== Modalidad de consumo (RF-03) ==== -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="MODALIDAD DE CONSUMO" Style="{DynamicResource EtiquetaCampo}" />
                    <UniformGrid Columns="2">
                        <RadioButton Content="En el local"
                                     Style="{DynamicResource MaterialDesignTabRadioButton}"
                                     GroupName="Modalidad"
                                     Margin="0,0,4,0"
                                     IsChecked="{Binding EsConsumoLocal}" />
                        <RadioButton Content="Para llevar"
                                     Style="{DynamicResource MaterialDesignTabRadioButton}"
                                     GroupName="Modalidad"
                                     Margin="4,0,0,0"
                                     IsChecked="{Binding EsParaLlevar}" />
                    </UniformGrid>
                </StackPanel>

                <!-- ==== Datos de la venta ==== -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">

                    <!-- Ubicación: solo en consumo local (RF-03) -->
                    <ComboBox materialDesign:HintAssist.Hint="Mesa o barra"
                              FontSize="13"
                              DisplayMemberPath="Descripcion"
                              ItemsSource="{Binding Ubicaciones}"
                              SelectedItem="{Binding UbicacionSeleccionada}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsConsumoLocal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- Mesero: solo si la ubicación es una mesa. En la barra atiende
                         el barman, así que la venta va sin mesero (RF-02). -->
                    <ComboBox materialDesign:HintAssist.Hint="Mesero"
                              FontSize="13"
                              Margin="0,14,0,0"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Meseros}"
                              SelectedItem="{Binding MeseroSeleccionado}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiereMesero}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ComboBox Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Cliente"
                              FontSize="13"
                              Margin="0,14,0,0"
                              DisplayMemberPath="NombreMostrado"
                              ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteSeleccionado}" />

                    <ComboBox Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Método de pago"
                              FontSize="13"
                              Margin="0,14,0,0"
                              DisplayMemberPath="NombreMetodo"
                              ItemsSource="{Binding MetodosPago}"
                              SelectedItem="{Binding MetodoPagoSeleccionado}" />
                </StackPanel>

                <!-- ==== Renglones del ticket ==== -->
                <Grid Grid.Row="3" Margin="0,18,0,0">

                    <TextBlock Text="Todavía no agregaste productos"
                               FontSize="13"
                               Foreground="#9AA3B2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TicketVacio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ticket}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F9FC"
                                            CornerRadius="12"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#2B3445"
                                                           TextWrapping="Wrap" />
                                                <TextBlock FontSize="11"
                                                           Foreground="#8A93A5"
                                                           Margin="0,2,0,0">
                                                    <Run Text="{Binding Cantidad, Mode=OneWay}" />
                                                    <Run Text="x" />
                                                    <Run Text="{Binding PrecioUnitario, Mode=OneWay, StringFormat={}{0:C0}}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{DynamicResource BotonQuitar}"
                                                    Width="28" Height="28"
                                                    ToolTip="Quitar una unidad"
                                                    Command="{Binding DataContext.QuitarUnidadCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" />
                                            </Button>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Subtotal, StringFormat={}{0:C0}}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="#2E7D32"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,6,0" />

                                            <Button Grid.Column="3"
                                                    Style="{DynamicResource MaterialDesignIconButton}"
                                                    Width="28" Height="28"
                                                    Foreground="#C62828"
                                                    ToolTip="Eliminar del ticket"
                                                    Command="{Binding DataContext.EliminarLineaCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ==== Total y acciones ==== -->
                <StackPanel Grid.Row="4" Margin="0,12,0,0">

                    <Border Height="1" Background="#E4E8F0" Margin="0,0,0,12" />

                    <!-- Mensajes de validacion del ViewModel -->
                    <TextBlock Text="{Binding Mensaje}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2E7D32" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayMensaje}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="15" Foreground="#2B3445" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Total, StringFormat={}{0:C0}}"
                                   FontWeight="Bold"
                                   FontSize="24"
                                   Foreground="#1565C0"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="16"
                                Content="Cancelar"
                                Height="48"
                                Width="110"
                                Margin="0,0,10,0"
                                FontSize="13"
                                Foreground="#C62828"
                                BorderBrush="#F2C7C7"
                                Cursor="Hand"
                                Command="{Binding CancelarTicketCommand}" />

                        <Button Grid.Column="1"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="16"
                                Height="48"
                                FontSize="14"
                                FontWeight="Bold"
                                Background="#2E7D32"
                                BorderBrush="#2E7D32"
                                Foreground="White"
                                Cursor="Hand"
                                Command="{Binding ConfirmarVentaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="CONFIRMAR VENTA" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

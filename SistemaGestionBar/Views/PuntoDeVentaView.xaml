<UserControl x:Class="SistemaGestionBar.Views.PuntoDeVentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
             xmlns:beh="clr-namespace:SistemaGestionBar.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PuntoDeVentaViewModel}"
             d:DesignHeight="820"
             d:DesignWidth="1360"
             Background="#F5F5F7">

    <UserControl.Resources>

        <Style x:Key="TarjetaProducto" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#E5E5EA" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="272" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaEnTicket}" Value="True">
                    <Setter Property="BorderBrush" Value="#34C759" />
                    <Setter Property="BorderThickness" Value="2.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SinStock}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="No" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TarjetaCategoria" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E5E5EA" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Background" Value="#0071E3" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TituloCategoria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtituloCategoria" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaSeleccionada}" Value="True">
                    <Setter Property="Foreground" Value="#BBDEFB" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonAgregar" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="BorderBrush" Value="#0A84FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>

        <Style x:Key="BotonQuitar" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#EDEDF0" />
            <Setter Property="BorderBrush" Value="#EDEDF0" />
            <Setter Property="Foreground" Value="#515154" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>

        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>


        <Style x:Key="SegmentoModalidad" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#515154" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fondo" CornerRadius="10" Padding="8,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{TemplateBinding Tag}" Width="18" Height="18"
                                                         Margin="0,0,7,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fondo" Property="Background" Value="White" />
                                <Setter TargetName="fondo" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="8" ShadowDepth="1" Direction="270" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#0071E3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="16"
                    Padding="20,14">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="22" ShadowDepth="4" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                        <Border Background="#E8F2FF" CornerRadius="12" Width="44" Height="44">
                            <materialDesign:PackIcon Kind="GlassCocktail"
                                                     Width="24" Height="24"
                                                     Foreground="#0071E3"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="PUNTO DE VENTA" FontWeight="Bold" FontSize="16" Foreground="#0071E3" />
                            <TextBlock Text="{Binding FechaActual}" FontSize="13" Foreground="#6E6E73" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="12,0,14,0">

                        <Border Background="#F5F5F7" CornerRadius="12" Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="{Binding TextoVentasDelDia}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#515154" />
                        </Border>

                        <Border Background="#FFF4E0"
                                CornerRadius="12"
                                Padding="14,8"
                                ToolTip="Insumos que llegaron al stock mínimo">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayAlertasStock}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOutline"
                                                         Width="16" Height="16"
                                                         Foreground="#FF9500"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TextoAlertas}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9500"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Button ToolTip="Crear copia de seguridad"
                                    Command="{Binding CrearBackupCommand}"
                                    Foreground="#6E6E73" Width="36" Height="36">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PuedeCrearBackup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <materialDesign:PackIcon Kind="DatabaseArrowUpOutline" Width="20" Height="20" />
                            </Button>
                        </StackPanel>

                        <Border Background="#0071E3" CornerRadius="18" Width="36" Height="36">
                            <TextBlock Text="{Binding InicialesUsuario}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,10,0">
                            <TextBlock Text="{Binding NombreUsuario}" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" />
                            <TextBlock Text="{Binding RolUsuario}" FontSize="12" Foreground="#6E6E73" />
                        </StackPanel>

                        <Button materialDesign:ButtonAssist.CornerRadius="16"
                                Command="{Binding VolverAlTableroCommand}"
                                ToolTip="Volver al tablero de administración"
                                Height="34"
                                Padding="14,0"
                                FontSize="13"
                                Foreground="#0071E3"
                                BorderBrush="#BBD5F2"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PuedeVolverAlTablero}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Tablero" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding CerrarSesionCommand}"
                                ToolTip="Cerrar sesión"
                                Foreground="#6E6E73"
                                Width="36" Height="36">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="14"
                    Padding="16,4"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0"
                                             Kind="Magnify"
                                             Width="20" Height="20"
                                             Foreground="#86868B"
                                             VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Style="{DynamicResource MaterialDesignTextBox}"
                             materialDesign:HintAssist.Hint="Buscar producto por nombre o descripción"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             BorderThickness="0"
                             FontSize="15"
                             Margin="10,8"
                             VerticalContentAlignment="Center"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </Grid>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Categorias}" Margin="0,16,-10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource TarjetaCategoria}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonUp">
                                    <i:InvokeCommandAction
                                        Command="{Binding DataContext.SeleccionarCategoriaCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}" Style="{DynamicResource TituloCategoria}" />
                                <TextBlock Text="{Binding TextoCantidad}" Style="{DynamicResource SubtituloCategoria}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3"
                       Text="Un clic en la tarjeta agrega el producto al ticket."
                       FontSize="12"
                       Foreground="#86868B"
                       Margin="2,14,0,10" />

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding VistaProductos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource TarjetaProducto}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="16" ShadowDepth="3" Direction="270" />
                                </Border.Effect>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction
                                            Command="{Binding DataContext.AgregarProductoCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Height="104">

                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#DCE7F7" Offset="0" />
                                                    <GradientStop Color="#B9CFEC" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Iniciales}"
                                                       Foreground="#0071E3"
                                                       FontWeight="Bold"
                                                       FontSize="30"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding RutaImagen, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneImagen}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border CornerRadius="8"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D9FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Background" Value="#F2E65100" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                            <Setter Property="Background" Value="#F2C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TextoStock}"
                                                       FontSize="11"
                                                       FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#515154" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <Button Width="30" Height="30"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Foreground="#AF52DE"
                                                Background="#E6FFFFFF"
                                                ToolTip="Ver receta"
                                                Command="{Binding DataContext.VerRecetaCommand,
                                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneReceta}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="BookOpenVariant" Width="17" Height="17" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Nombre}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               Foreground="#1D1D1F"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Descripcion}"
                                               FontSize="12"
                                               Foreground="#86868B"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />

                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Precio, StringFormat={}{0:C0}}"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   Foreground="#34C759"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding CantidadEnTicket}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#1D1D1F"
                                                       MinWidth="18"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstaEnTicket}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Style="{DynamicResource BotonAgregar}"
                                                    ToolTip="Agregar al ticket"
                                                    Command="{Binding DataContext.AgregarProductoCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="24"
                Margin="0,20,20,20"
                Padding="22">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="30" ShadowDepth="6" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Ticket actual" FontSize="26" FontWeight="Bold" Foreground="#1D1D1F"
                               VerticalAlignment="Center" />
                    <Border Background="#E8F2FF" CornerRadius="14" Padding="12,5"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CantidadUnidades, StringFormat={}{0} u.}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#0071E3" />
                    </Border>
                </Grid>

                <!-- Opciones -->
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Border Background="#EDEDF0" CornerRadius="13" Padding="3">
                        <UniformGrid Columns="2">
                            <RadioButton Tag="Storefront" Content="En el local"
                                         Style="{DynamicResource SegmentoModalidad}"
                                         GroupName="Modalidad"
                                         IsChecked="{Binding EsConsumoLocal}" />
                            <RadioButton Tag="ShoppingOutline" Content="Para llevar"
                                         Style="{DynamicResource SegmentoModalidad}"
                                         GroupName="Modalidad"
                                         IsChecked="{Binding EsParaLlevar}" />
                        </UniformGrid>
                    </Border>

                    <ComboBox materialDesign:HintAssist.Hint="Mesa o barra" beh:ComboAssist.Icono="TableFurniture"
                              Margin="0,12,0,0"
                              DisplayMemberPath="Descripcion"
                              ItemsSource="{Binding Ubicaciones}"
                              SelectedItem="{Binding UbicacionSeleccionada}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboApple}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsConsumoLocal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <ComboBox materialDesign:HintAssist.Hint="Mesero" beh:ComboAssist.Icono="AccountTie"
                              Margin="0,10,0,0"
                              DisplayMemberPath="NombreCompleto"
                              ItemsSource="{Binding Meseros}"
                              SelectedItem="{Binding MeseroSeleccionado}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboApple}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiereMesero}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Style="{DynamicResource ComboApple}"
                                  materialDesign:HintAssist.Hint="Cliente" beh:ComboAssist.Icono="AccountOutline"
                                  Margin="0,0,5,0"
                                  DisplayMemberPath="NombreMostrado"
                                  ItemsSource="{Binding Clientes}"
                                  SelectedItem="{Binding ClienteSeleccionado}" />

                        <ComboBox Grid.Column="1" Style="{DynamicResource ComboApple}"
                                  materialDesign:HintAssist.Hint="Método de pago" beh:ComboAssist.Icono="CreditCardOutline"
                                  Margin="5,0,0,0"
                                  DisplayMemberPath="NombreMetodo"
                                  ItemsSource="{Binding MetodosPago}"
                                  SelectedItem="{Binding MetodoPagoSeleccionado}" />
                    </Grid>
                </StackPanel>

                <!-- Productos del ticket -->
                <Grid Grid.Row="2" Margin="0,18,0,0">

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TicketVacio}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="64" Height="64" CornerRadius="32" Background="#F2F2F7" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="28" Height="28" Foreground="#86868B"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ticket vacío" FontSize="15" FontWeight="SemiBold" Foreground="#6E6E73"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Ticket}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F7F9" CornerRadius="16" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#E8F2FF"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Cantidad}" FontWeight="Bold" FontSize="14"
                                                           Foreground="#0071E3"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="#1D1D1F" TextWrapping="Wrap" />
                                                <TextBlock FontSize="12" Foreground="#6E6E73" Margin="0,2,0,0"
                                                           Text="{Binding PrecioUnitario, StringFormat={}{0:C0} c/u}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Subtotal, StringFormat={}{0:C0}}"
                                                       FontWeight="Bold" FontSize="15" Foreground="#1D1D1F"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{DynamicResource BotonQuitar}" Width="28" Height="28"
                                                        ToolTip="Quitar una unidad"
                                                        Command="{Binding DataContext.QuitarUnidadCommand,
                                                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" />
                                                </Button>
                                                <Button Style="{DynamicResource MaterialDesignIconButton}" Width="28" Height="28"
                                                        Foreground="#FF3B30" Margin="2,0,0,0"
                                                        ToolTip="Eliminar del ticket"
                                                        Command="{Binding DataContext.EliminarLineaCommand,
                                                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Total y acciones -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">

                    <TextBlock Text="{Binding Mensaje}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#248A3D" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayMensaje}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                                        <Setter Property="Foreground" Value="#D70015" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="#F2F2F7" CornerRadius="18" Padding="18,14" Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Total" FontWeight="SemiBold" FontSize="16" Foreground="#6E6E73"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Total, StringFormat={}{0:C0}}"
                                       FontWeight="Bold" FontSize="30" Foreground="#1D1D1F"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{DynamicResource BotonPeligro}"
                                Content="Cancelar"
                                Height="50" Width="116" Margin="0,0,10,0" FontSize="14"
                                Command="{Binding CancelarTicketCommand}" />

                        <Button Grid.Column="1"
                                Style="{DynamicResource BotonExito}"
                                Height="50" FontSize="15" FontWeight="Bold"
                                Command="{Binding ConfirmarVentaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Confirmar venta" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

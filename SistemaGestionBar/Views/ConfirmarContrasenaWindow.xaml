<Window x:Class="SistemaGestionBar.Views.ConfirmarContrasenaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirmar contraseña"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EstilosModal.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{DynamicResource HojaModal}">
        <StackPanel Margin="26">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <materialDesign:PackIcon Kind="LockOutline" Width="28" Height="28"
                                         Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
                <TextBlock Text="Ingresá tu contraseña" Style="{DynamicResource TituloModal}" Margin="12,0,0,0" />
            </StackPanel>

            <PasswordBox x:Name="txtClave"
                         materialDesign:HintAssist.Hint="Contraseña"
                         Style="{DynamicResource ClaveAdmin}"
                         Margin="0,0,0,6" />

            <TextBlock Text="{Binding MensajeError}" Foreground="{DynamicResource Peligro}"
                       FontSize="13" TextWrapping="Wrap" Margin="2,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Style="{DynamicResource BotonSecundario}" Margin="0,0,10,0" />
                <Button Content="Confirmar" Command="{Binding ConfirmarCommand}"
                        CommandParameter="{Binding ElementName=txtClave}"
                        Style="{DynamicResource BotonPrimario}" MinWidth="120" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="SistemaGestionBar.Views.AjusteStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AjusteDeStockViewModel}"
        Title="Ajustar stock"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="26">
        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border Background="#F5EAFB" CornerRadius="12" Width="44" Height="44">
                    <materialDesign:PackIcon Width="22" Height="22" Foreground="#AF52DE"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="BottleWine" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsInsumo}" Value="True">
                                        <Setter Property="Kind" Value="PackageVariantClosed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Nombre}" FontSize="19" FontWeight="Bold"
                               Foreground="#1D1D1F" TextWrapping="Wrap" Width="310" />
                    <TextBlock FontSize="13" Foreground="#6E6E73">
                        <Run Text="{Binding Tipo, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding UnidadMedida, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Border CornerRadius="12" Padding="16,13" Margin="0,18,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#E8F8EC" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                <Setter Property="Background" Value="#FFF4E0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="11.5" FontWeight="Bold" Text="{Binding TextoEstado}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#248A3D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                            <Setter Property="Foreground" Value="#B25000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12.5" Foreground="#515154" Margin="0,3,0,0">
                            <Run Text="Mínimo:" />
                            <Run Text="{Binding StockMinimo, StringFormat={}{0:0.##}, Mode=OneWay}" />
                            <Run Text="{Binding UnidadMedida, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1D1D1F"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Stock, StringFormat={}{0:0.##}, Mode=OneWay}" />
                        <TextBlock Text="hay ahora" FontSize="11.5" Foreground="#6E6E73"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="CUÁNTO ENTRA O CUÁNTO SALE" FontSize="12" FontWeight="Bold"
                       Foreground="#6E6E73" Margin="0,22,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Width="46" Height="46" Padding="0" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="14"
                        BorderBrush="#D2D2D7" Foreground="#515154"
                        Command="{Binding SumarCommand}" CommandParameter="-1"
                        ToolTip="Restar uno">
                    <materialDesign:PackIcon Kind="Minus" Width="20" Height="20" />
                </Button>

                <TextBox Grid.Column="1" Margin="10,0" TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                         materialDesign:HintAssist.Hint="0"
                         Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource CampoEnLinea}">
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="8,9" />
                            <Setter Property="MinHeight" Value="46" />
                            <Setter Property="Foreground" Value="#1D1D1F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HayCantidad}" Value="True">
                                    <Setter Property="Foreground" Value="#34C759" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HayProblema}" Value="True">
                                    <Setter Property="Foreground" Value="#FF3B30" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="2" Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Width="46" Height="46" Padding="0" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="14"
                        BorderBrush="#D2D2D7" Foreground="#515154"
                        Command="{Binding SumarCommand}" CommandParameter="1"
                        ToolTip="Sumar uno">
                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="3" Margin="10,0,0,0"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Width="46" Height="46" Padding="0" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="14"
                        BorderBrush="#E9D4F7" Foreground="#AF52DE"
                        Command="{Binding SugerirCommand}"
                        ToolTip="Proponer la cantidad que falta para salir del mínimo"
                        Visibility="{Binding StockBajo, Converter={StaticResource BoolAVisibilidad}}">
                    <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" />
                </Button>
            </Grid>

            <TextBlock FontSize="12" Foreground="#6E6E73" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Positivo entra (llegó mercadería), negativo sale (rotura, merma, consumo interno)." />

            <Border Background="#F7F7F9" CornerRadius="12" Padding="16,14" Margin="0,16,0,0"
                    Visibility="{Binding HayCantidad, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontSize="19" Foreground="#6E6E73" VerticalAlignment="Center"
                               Text="{Binding Stock, StringFormat={}{0:0.##}, Mode=OneWay}" />
                    <materialDesign:PackIcon Kind="ArrowRight" Width="22" Height="22" Margin="12,0"
                                             Foreground="#6E6E73" VerticalAlignment="Center" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#AF52DE"
                               VerticalAlignment="Center"
                               Text="{Binding StockResultante, StringFormat={}{0:0.##}, Mode=OneWay}" />
                    <TextBlock FontSize="13" Foreground="#6E6E73" Margin="8,0,0,0"
                               VerticalAlignment="Bottom" Padding="0,0,0,4"
                               Text="{Binding UnidadMedida, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Background="#FFEBEA" CornerRadius="10" Padding="13,10" Margin="0,14,0,0"
                    Visibility="{Binding HayProblema, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                             Foreground="#D70015" VerticalAlignment="Top" Margin="0,1,9,0" />
                    <TextBlock Text="{Binding Problema}" FontSize="13" Foreground="#D70015"
                               TextWrapping="Wrap" Width="310" />
                </StackPanel>
            </Border>

            <Border Background="#FFEBEA" CornerRadius="10" Padding="13,10" Margin="0,14,0,0"
                    Visibility="{Binding HayMensaje, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="17" Height="17"
                                             Foreground="#D70015" VerticalAlignment="Top" Margin="0,1,9,0" />
                    <TextBlock Text="{Binding Mensaje}" FontSize="13" Foreground="#D70015"
                               TextWrapping="Wrap" Width="310" />
                </StackPanel>
            </Border>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCELAR" IsCancel="True"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="16"
                        Height="44" FontSize="13" Padding="20,0" Cursor="Hand"
                        BorderBrush="#D2D2D7" Foreground="#515154" />

                <Button Grid.Column="1" Margin="10,0,0,0" IsDefault="True"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="16"
                        Height="44" FontSize="14" FontWeight="Bold"
                        Background="#34C759" BorderBrush="#34C759" Foreground="White"
                        Cursor="Hand" Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="GUARDAR STOCK" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminUsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminUsuariosViewModel}"
             d:DesignHeight="620" d:DesignWidth="1050">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Empleados" Style="{DynamicResource TituloPanel}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource BotonPrimario}" Command="{Binding NuevoCommand}"
                                Margin="0,0,8,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Nuevo" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource BotonSecundario}" Content="Editar" Padding="16,0"
                                Margin="0,0,8,0" Command="{Binding EditarCommand}" />
                        <Button Style="{DynamicResource BotonPeligro}" Content="Eliminar" Padding="16,0"
                                Command="{Binding EliminarCommand}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{DynamicResource BarraMensaje}">
                    <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBox Width="260" HorizontalAlignment="Left" Margin="0,0,0,8"
                             Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar por nombre, email, DNI o rol..." />

                    <DataGrid Style="{DynamicResource GrillaAdmin}"
                              ItemsSource="{Binding UsuariosView}"
                              SelectedItem="{Binding Seleccionado}">
                        <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Persona.Nombre}" Width="*" />
                        <DataGridTextColumn Header="Correo (acceso)" Binding="{Binding Persona.Email}" Width="200" />
                        <DataGridTextColumn Header="DNI / CUIT" Binding="{Binding Persona.DniCuit}" Width="120" />
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Persona.Telefono}" Width="120" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol.NombreRol}" Width="130" />
                    </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloEditor}" Style="{DynamicResource TituloPanel}" />

                <StackPanel IsEnabled="{Binding EnEdicion}">
                    <TextBlock Text="NOMBRE COMPLETO" Style="{DynamicResource EtiquetaAdmin}" Margin="0,0,0,4" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="DNI / CUIT" Style="{DynamicResource EtiquetaAdmin}" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding DniCuit, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="TELÉFONO" Style="{DynamicResource EtiquetaAdmin}" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="CORREO ELECTRÓNICO" Style="{DynamicResource EtiquetaAdmin}" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{DynamicResource TextoAyuda}"
                               Text="Es la credencial con la que inicia sesión: no puede repetirse." />

                    <TextBlock Text="ROL" Style="{DynamicResource EtiquetaAdmin}" />
                    <ComboBox Style="{DynamicResource ComboAdmin}"
                              DisplayMemberPath="NombreRol"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding RolSeleccionado}" />

                    <TextBlock Text="CONTRASEÑA" Style="{DynamicResource EtiquetaAdmin}" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding ClaveNueva, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{DynamicResource TextoAyuda}" Text="{Binding AyudaClave}" />
                    <TextBlock Style="{DynamicResource TextoAyuda}"
                               Text="Se guarda hasheada con PBKDF2: el sistema nunca almacena la clave en texto plano." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{DynamicResource BotonSecundario}" Content="Cancelar" Padding="18,0"
                            Margin="0,0,8,0" Command="{Binding CancelarCommand}" />
                    <Button Style="{DynamicResource BotonExito}" Content="Guardar" Padding="22,0"
                            Command="{Binding GuardarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

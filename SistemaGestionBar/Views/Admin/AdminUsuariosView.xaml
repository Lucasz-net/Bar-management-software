<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminUsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="clr-namespace:SistemaGestionBar.Behaviors"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminUsuariosViewModel}"
             d:DesignHeight="700" d:DesignWidth="1180">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             LISTA
             ============================================================ -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== BARRA DE ACCIONES Y BÚSQUEDA ==== -->
            <Border Grid.Row="0" Style="{DynamicResource PanelAdmin}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                                 Foreground="{DynamicResource TintaTenue}"
                                                 VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Grid.Column="1" Style="{DynamicResource BuscadorPlano}"
                                 materialDesign:HintAssist.Hint="Buscar por correo, nombre, DNI o rol"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Button Grid.Column="1" Style="{DynamicResource BotonPrimario}" Command="{Binding NuevoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountKeyOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Nueva cuenta" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==== FILTROS ==== -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox Style="{DynamicResource FiltroCombo}" MinWidth="164"
                              DisplayMemberPath="Texto"
                              ItemsSource="{Binding OpcionesRol}"
                              SelectedItem="{Binding RolFiltro}" />

                    <Button Style="{DynamicResource BotonSecundario}" Margin="8,0,0,0" Padding="11,0"
                            Command="{Binding LimpiarFiltrosCommand}" ToolTip="Quitar todos los filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" />
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Style="{DynamicResource ContadorFiltro}">
                        <Run Text="{Binding CantidadVisible, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="de" />
                        <Run Text="{Binding CantidadTotal, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding CantidadAdministradores, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="administran" />
                        <Run Text="·" />
                        <Run Text="{Binding CantidadEnSalon, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="en salón" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{DynamicResource BarraMensaje}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Style="{DynamicResource IconoMensaje}" />
                    <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
                </StackPanel>
            </Border>

            <!-- ==== GRILLA ==== -->
            <Border Grid.Row="3" Style="{DynamicResource PanelAdmin}" Padding="8,6,8,10" Margin="0,14,0,0">
                <Grid Style="{DynamicResource ZonaBloqueable}">
                    <DataGrid Style="{DynamicResource GrillaAdmin}"
                              ItemsSource="{Binding Vista}"
                              SelectedItem="{Binding Seleccionado}"
                              b:SelectorAssist.DesplazarASeleccion="True"
                              b:SelectorAssist.SeleccionBloqueada="{Binding EnEdicion}">
                        <DataGrid.Columns>
                            <!-- La cuenta se lee por su credencial: el correo arriba, y
                                 debajo de quién es, que es el dato que la vuelve humana. -->
                            <DataGridTemplateColumn Header="CUENTA" Width="*" MinWidth="260" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AcentoSuave}">
                                                <materialDesign:PackIcon Kind="AccountKeyOutline" Width="18" Height="18"
                                                                         Foreground="{DynamicResource Acento}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                                <TextBlock Text="{Binding Email}" FontSize="14.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}" />
                                                <TextBlock Text="{Binding NombreCompleto}" FontSize="12"
                                                           Foreground="{DynamicResource TintaSuave}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="DNI" Width="*" MinWidth="140" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" FontSize="13.5"
                                                   Foreground="{DynamicResource TintaFuerte}"
                                                   Text="{Binding Persona.DniFormateado, TargetNullValue='—'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ROL" Width="200" MinWidth="200" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource AcentoSuave}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Style="{DynamicResource TextoChip}" Foreground="{DynamicResource Acento}"
                                                       Text="{Binding NombreRol}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CantidadVisible}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="40" Height="40"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,10,0,0"
                                   Text="Ninguna cuenta coincide con el filtro." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             PANEL DERECHO: FICHA O FORMULARIO
             ============================================================ -->
        <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Style="{DynamicResource ChipIconoChico}">
                        <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource Acento}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding TituloEditor}" Style="{DynamicResource TituloEnLinea}" Margin="11,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">

                    <!-- ======== CARA 1: FICHA ======== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" VerticalAlignment="Top">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AcentoSuave}">
                                    <materialDesign:PackIcon Kind="AccountKeyOutline" Width="26" Height="26"
                                                             Foreground="{DynamicResource Acento}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding Seleccionado.NombreCompleto}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TintaFuerte}" TextWrapping="Wrap" MaxWidth="240" />
                                    <TextBlock Text="{Binding Seleccionado.Persona.DniFormateado}" FontSize="13"
                                               Foreground="{DynamicResource TintaSuave}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource AcentoSuave}">
                                    <TextBlock Style="{DynamicResource TextoChip}" Foreground="{DynamicResource Acento}"
                                               Text="{Binding Seleccionado.NombreRol}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="ACCESO AL SISTEMA" Style="{DynamicResource TituloBloque}" Margin="0,20,0,10" />
                            <Border Style="{DynamicResource SubPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Correo de trabajo" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionado.Email}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Rol" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionado.NombreRol}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Datos personales de solo lectura: acá se consultan, se
                                 corrigen en Personas. -->
                            <TextBlock Text="DATOS PERSONALES" Style="{DynamicResource TituloBloque}" Margin="0,18,0,10" />
                            <Border Style="{DynamicResource SubPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Correo personal" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionado.Persona.Email, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Teléfono" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionado.Persona.Telefono, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Style="{DynamicResource BotonSecundario}" Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding IrAPersonasCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                    <TextBlock Text="Ver su ficha en Personas" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sin nada elegido y sin formulario abierto -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="36" Height="36"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,12,0,0"
                                   Text="Elegí una cuenta de la lista para ver su ficha, editarla o eliminarla." />
                    </StackPanel>

                    <!-- ======== CARA 2: FORMULARIO ======== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                                  Visibility="{Binding EnEdicion, Converter={StaticResource BoolAVisibilidad}}">
                        <StackPanel>

                            <!-- ==== TITULAR ====
                                 Primero quién, después la credencial: sin persona no hay
                                 cuenta que crear. El DNI la trae del padrón. -->
                            <TextBlock Text="TITULAR DE LA CUENTA" Style="{DynamicResource TituloBloque}" />

                            <TextBlock Text="DNI" Style="{DynamicResource EtiquetaAdmin}" />
                            <!-- Se teclea sin puntos, igual que en Personas: el behavior no
                                 los deja escribir y al pegar los saca solo. El contador de
                                 Material queda apagado: el campo ya no admite más que los
                                 8 números, así que "8 / 8" no informa nada. -->
                            <TextBox Style="{DynamicResource CampoAdmin}" MaxLength="8"
                                     IsEnabled="{Binding EsAlta}"
                                     b:CampoNumerico.SoloDigitos="True"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     materialDesign:HintAssist.Hint="Ej: 40123456"
                                     Text="{Binding Dni, UpdateSourceTrigger=PropertyChanged, Delay=350}" />

                            <!-- Editando no se cambia de titular: eso sería dar de baja una
                                 cuenta y de alta otra, y las ventas ya apuntan a esta.
                                 El margen deja lugar al mensaje de error, que Material
                                 dibuja encima sin ocupar espacio propio. -->
                            <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,7,0,0"
                                       Visibility="{Binding EsAlta, Converter={StaticResource BoolAVisibilidad}}">
                                <materialDesign:PackIcon Kind="MagnifyScan" Width="12" Height="12" VerticalAlignment="Center" />
                                <Run Text="8 números, sin puntos. La persona tiene que estar cargada en el padrón." />
                            </TextBlock>

                            <!-- Persona encontrada: se muestra, no se edita. -->
                            <Border Style="{DynamicResource SubPanel}" Margin="0,10,0,0"
                                    Visibility="{Binding HayPersona, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AcentoSuave}">
                                        <materialDesign:PackIcon Kind="AccountCheckOutline" Width="19" Height="19"
                                                                 Foreground="{DynamicResource Acento}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0" Width="238">
                                        <TextBlock Text="{Binding NombrePersona}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TintaFuerte}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ContactoPersona}" FontSize="12"
                                                   Foreground="{DynamicResource TintaSuave}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- DNI completo que el padrón no tiene: no se inventa la
                                 persona acá, se ofrece el salto a Personas. -->
                            <Border Style="{DynamicResource SubPanel}" Margin="0,10,0,0"
                                    Background="{DynamicResource AvisoSuave}"
                                    Visibility="{Binding DniSinResultado, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountQuestionOutline" Width="16" Height="16"
                                                                 Foreground="{DynamicResource Aviso}"
                                                                 VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Style="{DynamicResource TextoAyuda}" Margin="9,0,0,0" Width="250"
                                                   Text="Ese DNI no está en el padrón. Cargá primero los datos personales y volvé a crear la cuenta." />
                                    </StackPanel>
                                    <Button Style="{DynamicResource BotonSecundario}" Margin="0,10,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding IrAPersonasCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Text="Ir a Personas" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ==== CREDENCIALES ==== -->
                            <TextBlock Text="ACCESO AL SISTEMA" Style="{DynamicResource TituloBloque}" Margin="0,18,0,0" />

                            <TextBlock Text="CORREO DE TRABAJO" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}"
                                     materialDesign:HintAssist.Hint="nombre@bar.com"
                                     Text="{Binding EmailTrabajo, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,14"
                                       Text="Es la credencial de inicio de sesión, distinta del correo personal." />

                            <TextBlock Text="ROL" Style="{DynamicResource EtiquetaAdmin}" />
                            <ComboBox Style="{DynamicResource ComboAdmin}"
                                      DisplayMemberPath="NombreRol"
                                      ItemsSource="{Binding Roles}"
                                      SelectedItem="{Binding RolSeleccionado}" />
                            <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,14"
                                       Text="Vendedor y Mesero tienen las mismas atribuciones: el rol dice el puesto y es lo que se registra al vender en una mesa." />

                            <TextBlock Text="CONTRASEÑA" Style="{DynamicResource EtiquetaAdmin}" />
                            <PasswordBox Style="{DynamicResource ClaveAdmin}"
                                         b:PasswordBoxAssist.Enlazar="True"
                                         b:PasswordBoxAssist.Password="{Binding ClaveNueva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,0"
                                       Text="{Binding AyudaClave}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==== PIE DE ACCIONES ==== -->
                <Grid Grid.Row="2">

                    <Grid Margin="0,16,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{DynamicResource BotonPanel}" Margin="0,0,5,0"
                                Command="{Binding EditarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Editar" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource BotonPanelPeligro}" Margin="5,0,0,0"
                                Command="{Binding EliminarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Eliminar" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding EnEdicion, Converter={StaticResource BoolAVisibilidad}}">
                        <Border Style="{DynamicResource PanelValidacion}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                         Foreground="#A93226" VerticalAlignment="Top" Margin="0,1,9,0" />
                                <TextBlock Style="{DynamicResource AvisoValidacion}" Width="288"
                                           Text="{Binding ResumenDeErrores}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{DynamicResource BotonSecundario}" Content="Cancelar"
                                    Margin="0,0,8,0" Command="{Binding CancelarCommand}" />
                            <Button Style="{DynamicResource BotonExito}" Command="{Binding GuardarCommand}" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Guardar" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

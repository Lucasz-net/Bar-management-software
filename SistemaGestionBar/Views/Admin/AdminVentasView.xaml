<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminVentasViewModel}"
             d:DesignHeight="700" d:DesignWidth="1180">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==== INDICADORES ==== -->
        <!-- Se recalculan con el filtro: si el usuario mira "hoy", los numeros son de hoy. -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="3">
            <Border Style="{DynamicResource TarjetaIndicador}" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource ChipIcono}">
                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource Acento}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource ValorIndicador}" Text="{Binding CantidadVentas}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Ventas en el período" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource TarjetaIndicador}" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource ChipIcono}" Background="{DynamicResource ExitoSuave}">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Foreground="#17703F"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource ValorIndicador}" Foreground="{DynamicResource Exito}"
                                   Text="{Binding TotalFacturado, StringFormat={}{0:C0}}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Total facturado" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource TarjetaIndicador}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource ChipIcono}" Background="#F1F4F9">
                        <materialDesign:PackIcon Kind="ChartLine" Width="20" Height="20"
                                                 Foreground="#5A6577"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource ValorIndicador}" Foreground="#5A6577"
                                   Text="{Binding TicketPromedio, StringFormat={}{0:C0}}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Ticket promedio" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ==== BÚSQUEDA ==== -->
        <Border Grid.Row="1" Style="{DynamicResource PanelAdmin}" Padding="14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                         Foreground="{DynamicResource TintaTenue}"
                                         VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Grid.Column="1" Style="{DynamicResource BuscadorPlano}"
                         materialDesign:HintAssist.Hint="Buscar por N° de venta, cliente, cajero, mesero, mesa o método de pago"
                         Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- ==== FILTROS ==== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <ListBox Style="{DynamicResource GrupoChips}"
                         DisplayMemberPath="Texto"
                         ItemsSource="{Binding OpcionesPeriodo}"
                         SelectedItem="{Binding Periodo}" />

                <Border Width="1" Background="{DynamicResource Linea}" Margin="6,4,12,4" />

                <ListBox Style="{DynamicResource GrupoChips}"
                         DisplayMemberPath="Texto"
                         ItemsSource="{Binding OpcionesModalidad}"
                         SelectedItem="{Binding Modalidad}" />

                <Button Style="{DynamicResource BotonSecundario}" Margin="6,0,0,0" Padding="11,0"
                        Command="{Binding LimpiarFiltrosCommand}" ToolTip="Quitar todos los filtros">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" />
                </Button>
            </StackPanel>

            <TextBlock Style="{DynamicResource ContadorFiltro}" HorizontalAlignment="Right">
                <Run Text="{Binding CantidadVisible, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="de" />
                <Run Text="{Binding CantidadTotal, Mode=OneWay}" />
                <Run Text="ventas" />
            </TextBlock>
        </Grid>

        <!-- ==== HISTORIAL + DETALLE ==== -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Padding="10,6,10,10" Margin="0,0,18,0">
                <Grid>
                    <DataGrid Style="{DynamicResource GrillaAdmin}"
                              ItemsSource="{Binding Vista}"
                              SelectedItem="{Binding Seleccionada}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="VENTA" Width="132" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TintaFuerte}">
                                                <Run Text="#" /><Run Text="{Binding IdVenta, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding FechaHora, StringFormat={}{0:dd/MM/yy HH:mm}}"
                                                       FontSize="11" Foreground="{DynamicResource TintaSuave}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="DÓNDE" Width="145" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Width="15" Height="15" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TintaSuave}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="TableChair" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ubicacion}" Value="{x:Null}">
                                                                <Setter Property="Kind" Value="ShoppingOutline" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <!-- FallbackValue ademas de TargetNullValue: cuando el nulo es un
                                                     eslabon del camino (Ubicacion) y no el valor final, WPF usa el
                                                     Fallback y el TargetNullValue nunca llega a aplicarse. -->
                                                <TextBlock Text="{Binding Ubicacion.NombreUbicacion, TargetNullValue='Para llevar', FallbackValue='Para llevar'}"
                                                           FontSize="12.5" Foreground="{DynamicResource TintaFuerte}" />
                                                <TextBlock Text="{Binding MetodoPago.NombreMetodo}" FontSize="11"
                                                           Foreground="{DynamicResource TintaSuave}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="QUIÉN ATENDIÓ" Width="*" MinWidth="175" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Cajero.NombreCompleto}" FontSize="12.5"
                                                       Foreground="{DynamicResource TintaFuerte}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TintaSuave}">
                                                <Run Text="mesero:" />
                                                <Run Text="{Binding Mesero.NombreCompleto, Mode=OneWay, TargetNullValue='sin mesero', FallbackValue='sin mesero'}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CLIENTE" Width="*" MinWidth="140"
                                                Binding="{Binding Cliente.NombreMostrado}" />

                            <DataGridTemplateColumn Header="TOTAL" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Total, StringFormat={}{0:C0}}"
                                                   FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Acento}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CantidadVisible}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ReceiptTextRemoveOutline" Width="40" Height="40"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,10,0,0"
                                   Text="Ninguna venta coincide con el filtro." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==== DETALLE ==== -->
            <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{DynamicResource ChipIconoChico}">
                            <materialDesign:PackIcon Kind="TextBoxOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource Acento}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TituloDetalle}" Style="{DynamicResource TituloEnLinea}" Margin="11,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HaySeleccion}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Style="{DynamicResource SubPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Cliente" Style="{DynamicResource RotuloIndicador}" Margin="0" />
                                    <TextBlock Text="{Binding Seleccionada.Cliente.NombreMostrado}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Método de pago" Style="{DynamicResource RotuloIndicador}" Margin="0" />
                                    <TextBlock Text="{Binding Seleccionada.MetodoPago.NombreMetodo}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Estado" Style="{DynamicResource RotuloIndicador}" Margin="0" />
                                    <TextBlock Text="{Binding Seleccionada.EstadoVenta}" FontSize="12.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Exito}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Factura" Style="{DynamicResource RotuloIndicador}" Margin="0" />
                                    <TextBlock Text="{Binding FacturaDeLaVenta.Numero, TargetNullValue='sin emitir', FallbackValue='sin emitir'}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TintaFuerte}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{DynamicResource BotonSecundario}" Command="{Binding VerFacturaCommand}"
                                Margin="0,12,0,0" IsEnabled="{Binding TieneFactura}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Ver factura" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Style="{DynamicResource GrillaAdmin}"
                              ItemsSource="{Binding Detalle}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Producto.Nombre}" Width="*" />
                            <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="52" />
                            <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat={}{0:C0}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="{DynamicResource AcentoSuave}" CornerRadius="12"
                            Padding="16,12" Margin="0,14,0,0">
                        <Grid>
                            <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource TintaFuerte}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Seleccionada.Total, StringFormat={}{0:C0}}"
                                       FontWeight="Bold" FontSize="20" Foreground="{DynamicResource Acento}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

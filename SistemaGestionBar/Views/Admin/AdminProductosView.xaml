<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminProductosViewModel}"
             d:DesignHeight="620" d:DesignWidth="1050">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- ============ LISTA ============ -->
        <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Catálogo" Style="{DynamicResource TituloPanel}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource BotonPrimario}"
                                Command="{Binding NuevoCommand}" Margin="0,0,8,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Nuevo" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource BotonSecundario}"
                                Content="Editar" Padding="16,0" Margin="0,0,8,0"
                                Command="{Binding EditarCommand}" />
                        <Button Style="{DynamicResource BotonPeligro}"
                                Content="Eliminar" Padding="16,0"
                                Command="{Binding EliminarCommand}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{DynamicResource BarraMensaje}">
                    <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
                </Border>

                <DataGrid Grid.Row="2"
                          Style="{DynamicResource GrillaAdmin}"
                          ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding Seleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.NombreCategoria}" Width="120" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C0}}" Width="100" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70" />
                        <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="70" />
                        <DataGridTemplateColumn Header="Receta" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="BookOpenVariant" Width="17" Height="17"
                                                             Foreground="#7B5BD6"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TieneReceta}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ EDITOR ============ -->
        <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TituloEditor}" Style="{DynamicResource TituloPanel}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel IsEnabled="{Binding EnEdicion}">

                        <TextBlock Text="NOMBRE" Style="{DynamicResource EtiquetaAdmin}" Margin="0,0,0,4" />
                        <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="DESCRIPCIÓN" Style="{DynamicResource EtiquetaAdmin}" />
                        <TextBox Style="{DynamicResource CampoAdmin}" TextWrapping="Wrap" MinLines="2"
                                 Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="CATEGORÍA" Style="{DynamicResource EtiquetaAdmin}" />
                        <ComboBox Style="{DynamicResource ComboAdmin}"
                                  DisplayMemberPath="NombreCategoria"
                                  ItemsSource="{Binding Categorias}"
                                  SelectedItem="{Binding CategoriaSeleccionada}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="PRECIO" Style="{DynamicResource EtiquetaAdmin}" />
                                <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="STOCK" Style="{DynamicResource EtiquetaAdmin}" />
                                <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="MÍNIMO" Style="{DynamicResource EtiquetaAdmin}" />
                                <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{DynamicResource TextoAyuda}">
                            <Run Text="Stock y mínimo solo se usan en productos de venta directa." />
                            <Run Text="Si el producto tiene receta, su disponibilidad sale de los insumos." />
                        </TextBlock>

                        <TextBlock Text="FOTO (RUTA)" Style="{DynamicResource EtiquetaAdmin}" />
                        <TextBox Style="{DynamicResource CampoAdmin}" TextWrapping="Wrap"
                                 Text="{Binding RutaImagen, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{DynamicResource TextoAyuda}"
                                   Text="Dejar vacío para que la tarjeta muestre las iniciales." />

                        <Border Height="1" Background="#EDF1F6" Margin="0,18" />

                        <!-- ============ RECETA ============ -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenVariant" Width="17" Height="17"
                                                     Foreground="#7B5BD6" VerticalAlignment="Center" />
                            <TextBlock Text="Receta" FontSize="14" FontWeight="Bold" Foreground="#2B3445"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource TextoAyuda}"
                                   Text="Sin ingredientes, el producto es de venta directa y no muestra el botón de receta." />

                        <TextBlock Text="INGREDIENTES" Style="{DynamicResource EtiquetaAdmin}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Style="{DynamicResource ComboAdmin}"
                                      materialDesign:HintAssist.Hint="Insumo"
                                      DisplayMemberPath="Nombre"
                                      ItemsSource="{Binding Ingredientes}"
                                      SelectedItem="{Binding IngredienteAAgregar}" />
                            <Button Grid.Column="1" Style="{DynamicResource BotonPrimario}"
                                    MinWidth="0" Width="38" Padding="0" Margin="6,0,0,0"
                                    ToolTip="Agregar a la receta"
                                    Command="{Binding AgregarIngredienteCommand}">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Composicion}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F9FC" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Ingrediente.Nombre}"
                                                       FontSize="12.5" Foreground="#2B3445"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBox Grid.Column="1" Style="{DynamicResource CampoAdmin}"
                                                     FontSize="12" Padding="6,4" Margin="6,0"
                                                     Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnidadMedida}"
                                                       FontSize="11" Foreground="#8A93A5"
                                                       VerticalAlignment="Center" MinWidth="46" />
                                            <Button Grid.Column="3" Style="{DynamicResource BotonIconoFila}"
                                                    Foreground="#C62828" ToolTip="Quitar de la receta"
                                                    Command="{Binding DataContext.QuitarIngredienteCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="PREPARACIÓN PASO A PASO" Style="{DynamicResource EtiquetaAdmin}" />
                        <TextBox Style="{DynamicResource CampoAdmin}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinLines="5" MaxLines="12"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Instrucciones, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{DynamicResource TextoAyuda}"
                                   Text="Un paso por línea. Se guarda en la tabla Receta." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Style="{DynamicResource BotonSecundario}" Content="Cancelar" Padding="18,0"
                            Margin="0,0,8,0" Command="{Binding CancelarCommand}" />
                    <Button Style="{DynamicResource BotonExito}" Content="Guardar" Padding="22,0"
                            Command="{Binding GuardarCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

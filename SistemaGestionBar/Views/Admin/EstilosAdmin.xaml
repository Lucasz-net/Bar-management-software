<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Estilos compartidos por las secciones del tablero de administración.
         Vive en un diccionario aparte para que las 7 pantallas no repitan lo mismo. -->

    <!-- ============ SUPERFICIES ============ -->
    <Style x:Key="PanelAdmin" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="#E4E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="TarjetaIndicador" TargetType="Border" BasedOn="{StaticResource PanelAdmin}">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinWidth" Value="168" />
    </Style>

    <!-- ============ TIPOGRAFIA ============ -->
    <Style x:Key="TituloPanel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#2B3445" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="EtiquetaAdmin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#8A93A5" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="ValorIndicador" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#1565C0" />
    </Style>

    <Style x:Key="RotuloIndicador" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#8A93A5" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="TextoAyuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#9AA3B2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- ============ CAMPOS ============ -->
    <Style x:Key="CampoAdmin" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="ComboAdmin" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ============ BOTONES ============ -->
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#1565C0" />
        <Setter Property="BorderBrush" Value="#1565C0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="#2E7D32" />
        <Setter Property="BorderBrush" Value="#2E7D32" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#5A6577" />
        <Setter Property="BorderBrush" Value="#CFD7E3" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#C62828" />
        <Setter Property="BorderBrush" Value="#F2C7C7" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="BotonIconoFila" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ============ GRILLAS ============ -->
    <Style x:Key="GrillaAdmin" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Grilla editable, para las tablas paramétricas -->
    <Style x:Key="GrillaEditable" TargetType="DataGrid" BasedOn="{StaticResource GrillaAdmin}">
        <Setter Property="IsReadOnly" Value="False" />
    </Style>

    <!-- ============ BARRA DE MENSAJES ============ -->
    <Style x:Key="BarraMensaje" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Background" Value="#E4F3EA" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HayMensaje}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                <Setter Property="Background" Value="#FBE9E7" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextoMensaje" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#17703F" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                <Setter Property="Foreground" Value="#A93226" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:beh="clr-namespace:SistemaGestionBar.Behaviors">

    <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />

    <SolidColorBrush x:Key="TintaFuerte" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TintaSuave"  Color="#6E6E73" />
    <SolidColorBrush x:Key="TintaTenue"  Color="#86868B" />
    <SolidColorBrush x:Key="Acento"      Color="#0071E3" />
    <SolidColorBrush x:Key="AcentoSuave" Color="#E8F2FF" />
    <SolidColorBrush x:Key="Linea"       Color="#E5E5EA" />
    <SolidColorBrush x:Key="Fondo"       Color="#F5F5F7" />
    <SolidColorBrush x:Key="Exito"       Color="#34C759" />
    <SolidColorBrush x:Key="ExitoSuave"  Color="#E8F8EC" />
    <SolidColorBrush x:Key="Aviso"       Color="#FF9500" />
    <SolidColorBrush x:Key="AvisoSuave"  Color="#FFF4E0" />
    <SolidColorBrush x:Key="Peligro"     Color="#FF3B30" />
    <SolidColorBrush x:Key="PeligroSuave" Color="#FFEBEA" />

    <DropShadowEffect x:Key="SombraTarjeta" Color="#000000" Opacity="0.07"
                      BlurRadius="26" ShadowDepth="5" Direction="270" />

    <Style x:Key="PanelAdmin" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect" Value="{DynamicResource SombraTarjeta}" />
    </Style>

    <Style x:Key="SubPanel" TargetType="Border">
        <Setter Property="Background" Value="#FAFAFC" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="TarjetaIndicador" TargetType="Border" BasedOn="{StaticResource PanelAdmin}">
        <Setter Property="Background" Value="{DynamicResource FondoTarjeta}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinWidth" Value="162" />
    </Style>

    <Style x:Key="FranjaIndicador" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <LinearGradientBrush x:Key="FondoTarjeta" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F3F8FF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="ContenidoIndicador" TargetType="StackPanel">
        <Setter Property="Margin" Value="18,16,18,16" />
    </Style>

    <Style x:Key="TarjetaAccion" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Tag" Value="{DynamicResource Acento}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="162" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tarjeta"
                            Background="{DynamicResource FondoTarjeta}"
                            CornerRadius="16"
                            BorderBrush="{DynamicResource Linea}"
                            BorderThickness="1.5"
                            Effect="{DynamicResource SombraTarjeta}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" Margin="17,16,18,16" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tarjeta" Property="BorderBrush" Value="{DynamicResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tarjeta" Property="Background" Value="#F5F9FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlechaTarjeta" TargetType="materialDesign:PackIcon">
        <Setter Property="Kind" Value="ArrowRight" />
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Acento}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipIcono" TargetType="Border">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="Background" Value="{DynamicResource AcentoSuave}" />
    </Style>

    <Style x:Key="ChipIconoChico" TargetType="Border" BasedOn="{StaticResource ChipIcono}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
    </Style>

    <Style x:Key="TituloPanel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/SistemaGestionBar;component/Assets/Fonts/#Inter" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="TituloEnLinea" TargetType="TextBlock" BasedOn="{StaticResource TituloPanel}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EtiquetaAdmin" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="TituloBloque" TargetType="TextBlock" BasedOn="{StaticResource EtiquetaAdmin}">
        <Setter Property="Foreground" Value="{DynamicResource Acento}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="RotuloDato" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValorDato" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="225" />
    </Style>

    <Style x:Key="ValorIndicador" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/SistemaGestionBar;component/Assets/Fonts/#Inter" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Acento}" />
    </Style>

    <Style x:Key="RotuloIndicador" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="TextoAyuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <Style x:Key="TextoVacio" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TintaTenue}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="CampoAdmin" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,22" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="12" />
        <Setter Property="materialDesign:ValidationAssist.UsePopup" Value="False" />
        <Setter Property="materialDesign:ValidationAssist.FontSize" Value="11.5" />
        <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
    </Style>

    <Style x:Key="CampoEnLinea" TargetType="TextBox" BasedOn="{StaticResource CampoAdmin}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="7,5" />
    </Style>

    <Style x:Key="CampoAngosto" TargetType="TextBox" BasedOn="{StaticResource CampoAdmin}">
        <Setter Property="Margin" Value="0,0,0,40" />
    </Style>


    <Style x:Key="ClaveAdmin" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,22" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:ValidationAssist.UsePopup" Value="False" />
        <Setter Property="materialDesign:ValidationAssist.FontSize" Value="11.5" />
    </Style>

    <Style x:Key="BuscadorPlano" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Hidden" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
    </Style>

    <Style x:Key="ChipFiltro" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="fondo"
                            CornerRadius="17"
                            Padding="16,8"
                            Background="#F2F2F7"
                            BorderBrush="#E5E5EA"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="BorderBrush" Value="#B8D8FA" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource Acento}" />
                            <Setter TargetName="fondo" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrupoChips" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ChipFiltro}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ContadorFiltro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="21" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Acento}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="Background" Value="{DynamicResource Exito}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Exito}" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="21" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#515154" />
        <Setter Property="BorderBrush" Value="#D2D2D7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Foreground" Value="{DynamicResource Peligro}" />
        <Setter Property="BorderBrush" Value="#FFD1CE" />
    </Style>

    <Style x:Key="BotonIconoFila" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="33" />
        <Setter Property="Height" Value="33" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="BotonPanel" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BotonPanelPeligro" TargetType="Button" BasedOn="{StaticResource BotonPeligro}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZonaBloqueable" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding EnEdicion}" Value="True">
                <Setter Property="Opacity" Value="0.55" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SeparadorEditor" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#EDEDF0" />
        <Setter Property="Margin" Value="0,4,0,16" />
    </Style>

    <Style x:Key="EncabezadoGrilla" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
        <Setter Property="Padding" Value="10,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
        <Setter Property="SeparatorVisibility" Value="Collapsed" />
    </Style>

    <Style x:Key="FilaGrilla" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border x:Name="fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" />

                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Row="0"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Row="1"
                                                      Visibility="{TemplateBinding DetailsVisibility}" />
                        </SelectiveScrollingGrid>

                        <Border x:Name="contorno"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="#F7F7F9" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="contorno" Property="BorderBrush" Value="{DynamicResource Acento}" />
                            <Setter TargetName="fondo" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CeldaGrilla" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GrillaAdmin" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="RowHeight" Value="56" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EncabezadoGrilla}" />
        <Setter Property="RowStyle" Value="{StaticResource FilaGrilla}" />
        <Setter Property="CellStyle" Value="{StaticResource CeldaGrilla}" />
    </Style>

    <Style x:Key="GrillaEditable" TargetType="DataGrid" BasedOn="{StaticResource GrillaAdmin}">
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="RowHeight" Value="50" />
    </Style>

    <Style x:Key="BarraStock" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#EDEDF0" />
        <Setter Property="Foreground" Value="{DynamicResource Exito}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Decorator x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StockBajo}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Aviso}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipGrilla" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextoChip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BarraMensaje" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Background" Value="{DynamicResource ExitoSuave}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HayMensaje}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PeligroSuave}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextoMensaje" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#248A3D" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                <Setter Property="Foreground" Value="#D70015" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconoMensaje" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Kind" Value="CheckCircleOutline" />
        <Setter Property="Foreground" Value="#248A3D" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
                <Setter Property="Kind" Value="AlertCircleOutline" />
                <Setter Property="Foreground" Value="#D70015" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelValidacion" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PeligroSuave}" />
        <Setter Property="BorderBrush" Value="#FFD1CE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding EnEdicion}" Value="True" />
                    <Condition Binding="{Binding HayErroresVisibles}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ChipPeriodo">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="16" Height="16" Margin="0,0,7,0"
                                     VerticalAlignment="Center">
                <materialDesign:PackIcon.Style>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Texto}" Value="Elegir fecha">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
            <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Menús desplegables: caja redondeada y lista flotante con esquinas amplias. -->
    <Style x:Key="ItemComboApple" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="fondo" CornerRadius="10" Padding="12,9" Margin="0,1" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource Fondo}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{DynamicResource AcentoSuave}" />
                            <Setter Property="Foreground" Value="{DynamicResource Acento}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboApple" TargetType="ComboBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D2D2D7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,0,10,0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ItemComboApple}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="caja" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon x:Name="iconoCombo" Grid.Column="0" Width="18" Height="18"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Kind="{Binding Path=(beh:ComboAssist.Icono), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Circle}"
                                                     Foreground="{DynamicResource Acento}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="sugerencia" Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding Path=(materialDesign:HintAssist.Hint), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource TintaTenue}" Visibility="Collapsed" />
                            <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="18" Height="18"
                                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource TintaSuave}" />
                        </Grid>

                        <ToggleButton ClickMode="Press" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Grid MinWidth="{Binding ActualWidth, ElementName=caja}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Margin="0,6,0,16" Background="White" CornerRadius="14"
                                        BorderBrush="{DynamicResource Linea}" BorderThickness="1" Padding="5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.16" BlurRadius="24" ShadowDepth="6" Direction="270" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="beh:ComboAssist.Icono" Value="{x:Null}">
                            <Setter TargetName="iconoCombo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="sugerencia" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{DynamicResource Acento}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{DynamicResource Acento}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="caja" Property="BorderBrush" Value="{DynamicResource Peligro}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboAdmin" TargetType="ComboBox" BasedOn="{StaticResource ComboApple}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>

    <Style x:Key="FiltroCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboApple}">
        <Setter Property="MinWidth" Value="184" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Hoja modal estilo Apple: esquinas amplias, borde de un píxel y sombra difusa. -->
    <Style x:Key="HojaModal" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="40" ShadowDepth="10" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TituloModal" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/SistemaGestionBar;component/Assets/Fonts/#Inter" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BotonRangoFechas" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Acento}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AvisoValidacion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#D70015" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>

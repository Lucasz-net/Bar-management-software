<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="clr-namespace:SistemaGestionBar.Behaviors"
             xmlns:rep="clr-namespace:SistemaGestionBar.Reportes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminReportesViewModel}"
             d:DesignHeight="700" d:DesignWidth="1180">

    <UserControl.Resources>

        <!-- Tarjeta de la lista de reportes. Es propia de esta pantalla, asi que vive aca
             y no en EstilosAdmin: alli van los estilos que comparten varias secciones.
             Sigue la misma regla que las grillas: seleccionado = contorno, no relleno. -->
        <Style x:Key="TarjetaReporte" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tarjeta"
                                Background="#FBFCFE"
                                BorderBrush="{DynamicResource Linea}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tarjeta" Property="BorderBrush" Value="#BBD5F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tarjeta" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                <Setter TargetName="tarjeta" Property="Background" Value="{DynamicResource AcentoSuave}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==== PERIODO Y DESCARGA ====
             El periodo se apaga (no se esconde) para el catalogo y el inventario: esos dos
             son una foto de como esta el bar hoy, no de un rango de fechas. Apagarlo explica
             por que no aplica; esconderlo dejaria al usuario buscando el selector. -->
        <Border Grid.Row="0" Style="{DynamicResource PanelAdmin}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="PERÍODO" Style="{DynamicResource EtiquetaAdmin}" Margin="2,0,0,7" />

                    <ListBox Style="{DynamicResource GrupoChips}"
                             DisplayMemberPath="Texto"
                             ItemsSource="{Binding OpcionesPeriodo}"
                             SelectedItem="{Binding Periodo}"
                             IsEnabled="{Binding PeriodoEsAplicable}" />

                    <!-- BooleanToVisibilityConverter no acepta parametro, asi que la version
                         invertida se hace con un DataTrigger sobre el contenedor. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PeriodoEsAplicable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{DynamicResource TextoAyuda}" Margin="2,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="Este reporte muestra el estado actual, no depende del periodo." />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{DynamicResource BotonPrimario}"
                        Command="{Binding ExportarCommand}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        ToolTip="Guarda el reporte como archivo PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="19" Height="19" VerticalAlignment="Center" />
                        <TextBlock Text="Descargar PDF" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource BarraMensaje}" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Style="{DynamicResource IconoMensaje}" />
                <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="336" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== QUE REPORTE ==== -->
            <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{DynamicResource ChipIconoChico}">
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource Acento}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Reportes disponibles" Style="{DynamicResource TituloEnLinea}"
                                   Margin="11,0,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding Disponibles}"
                                 SelectedItem="{Binding Seleccionado}"
                                 ItemContainerStyle="{StaticResource TarjetaReporte}"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{DynamicResource ChipIconoChico}"
                                                VerticalAlignment="Top">
                                            <materialDesign:PackIcon Kind="{Binding Icono}" Width="18" Height="18"
                                                                     Foreground="{DynamicResource Acento}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding Titulo}" FontSize="14.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TintaFuerte}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Descripcion}" FontSize="12.5"
                                                       Foreground="{DynamicResource TintaSuave}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==== VISTA PREVIA ====
                 Es el mismo ContenidoDeReporte que se imprime en el PDF, dibujado con los
                 estilos del tablero: lo que se ve aca es exactamente lo que sale exportado. -->
            <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HayVistaPrevia, Converter={StaticResource BoolAVisibilidad}}">
                        <StackPanel Margin="0,0,10,0">

                            <!-- Encabezado del documento -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Contenido.Titulo}" FontSize="21" FontWeight="Bold"
                                               Foreground="{DynamicResource Acento}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Contenido.Subtitulo}" FontSize="13"
                                               Foreground="{DynamicResource TintaSuave}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Contenido.GeneradoPor}" FontSize="12.5"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TintaFuerte}" />
                                    <TextBlock Text="{Binding Contenido.GeneradoEl, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TintaTenue}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="2" Background="{DynamicResource Acento}" Margin="0,0,0,18" />

                            <!-- Los bloques. Cada tipo trae su plantilla: WPF elige por DataType,
                                 igual que el router elige la vista de cada ViewModel. -->
                            <ItemsControl ItemsSource="{Binding Contenido.Bloques}">
                                <ItemsControl.Resources>

                                    <DataTemplate DataType="{x:Type rep:BloqueIndicadores}">
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="{Binding Titulo}" Style="{DynamicResource TituloBloque}" />
                                            <ItemsControl ItemsSource="{Binding Valores}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Fondo}"
                                                                BorderBrush="{DynamicResource Linea}"
                                                                BorderThickness="1" CornerRadius="10"
                                                                Padding="14,11" Margin="0,0,10,10"
                                                                MinWidth="152">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Etiqueta}"
                                                                           Style="{DynamicResource RotuloIndicador}"
                                                                           Margin="0" />
                                                                <TextBlock Text="{Binding Valor}" FontSize="21"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource Acento}"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type rep:BloqueTabla}">
                                        <StackPanel Margin="0,0,0,22">
                                            <TextBlock Text="{Binding Titulo}" Style="{DynamicResource TituloBloque}" />
                                            <ContentControl b:TablaDeReporteAssist.Bloque="{Binding}"
                                                            Margin="0,8,0,0" />
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type rep:BloqueTexto}">
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="{Binding Titulo}" Style="{DynamicResource TituloBloque}" />
                                            <TextBlock Text="{Binding Texto}" Style="{DynamicResource TextoAyuda}"
                                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>

                                </ItemsControl.Resources>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayVistaPrevia}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="44" Height="44"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,10,0,0"
                                   Text="Elegí un reporte de la lista para verlo acá." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

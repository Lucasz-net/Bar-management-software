<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminInventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminInventarioViewModel}"
             d:DesignHeight="620" d:DesignWidth="1050">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Insumos" Style="{DynamicResource TituloPanel}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource BotonPrimario}" Command="{Binding NuevoCommand}"
                                Margin="0,0,8,0" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Nuevo" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource BotonSecundario}" Content="Editar" Padding="16,0"
                                Margin="0,0,8,0" Command="{Binding EditarCommand}" />
                        <Button Style="{DynamicResource BotonPeligro}" Content="Eliminar" Padding="16,0"
                                Command="{Binding EliminarCommand}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{DynamicResource BarraMensaje}">
                    <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
                </Border>

                <DataGrid Grid.Row="2" Style="{DynamicResource GrillaAdmin}"
                          ItemsSource="{Binding Ingredientes}"
                          SelectedItem="{Binding Seleccionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Insumo" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="100" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock, StringFormat={}{0:0.##}}" Width="100" />
                        <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat={}{0:0.##}}" Width="100" />
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E4F3EA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                        <Setter Property="Background" Value="#FBEEDB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="OK">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#17703F" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                            <Setter Property="Foreground" Value="#96560A" />
                                                            <Setter Property="Text" Value="REPONER" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TituloEditor}" Style="{DynamicResource TituloPanel}" />

                <StackPanel IsEnabled="{Binding EnEdicion}">
                    <TextBlock Text="NOMBRE" Style="{DynamicResource EtiquetaAdmin}" Margin="0,0,0,4" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="UNIDAD DE MEDIDA" Style="{DynamicResource EtiquetaAdmin}" />
                    <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding UnidadMedida, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{DynamicResource TextoAyuda}" Text="Ej: ml, g, hojas, cubos, unidades." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="STOCK ACTUAL" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="STOCK MÍNIMO" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}" Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{DynamicResource TextoAyuda}"
                               Text="Al llegar al mínimo, el insumo aparece en las alertas del resumen y del punto de venta." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{DynamicResource BotonSecundario}" Content="Cancelar" Padding="18,0"
                            Margin="0,0,8,0" Command="{Binding CancelarCommand}" />
                    <Button Style="{DynamicResource BotonExito}" Content="Guardar" Padding="22,0"
                            Command="{Binding GuardarCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

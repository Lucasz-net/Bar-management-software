<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminResumenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminResumenViewModel}"
             d:DesignHeight="700" d:DesignWidth="1180"
             FontFamily="/SistemaGestionBar;component/Assets/Fonts/#Inter">

    <UserControl.Resources>
        <Style x:Key="NumeroGrande" TargetType="TextBlock" BasedOn="{StaticResource ValorIndicador}">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="BarraProporcion" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E5E5EA" />
            <Setter Property="Foreground" Value="#AF52DE" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid>
                                <Decorator x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PuntoLeyenda" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="1" Margin="-7,0">

            <Button Style="{DynamicResource TarjetaAccion}" Margin="7,0"
                    Command="{Binding IrAVentasCommand}" ToolTip="Ver el historial de ventas">
                <Grid>
                    <materialDesign:PackIcon Style="{DynamicResource FlechaTarjeta}" />
                    <StackPanel>
                        <Border Style="{DynamicResource ChipIcono}" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20"
                                                     Foreground="{DynamicResource Acento}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource NumeroGrande}" Text="{Binding VentasDelDia}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Ventas hoy" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{DynamicResource TarjetaAccion}" Margin="7,0"
                    Command="{Binding IrAVentasCommand}" ToolTip="Ver el historial de ventas"
                    Tag="{DynamicResource Exito}">
                <Grid>
                    <materialDesign:PackIcon Style="{DynamicResource FlechaTarjeta}" />
                    <StackPanel>
                        <Border Style="{DynamicResource ChipIcono}" Background="{DynamicResource ExitoSuave}" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Foreground="#248A3D"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource NumeroGrande}" Foreground="{DynamicResource Exito}"
                                   Text="{Binding FacturadoHoy, StringFormat={}{0:C0}}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Facturado hoy" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{DynamicResource TarjetaAccion}" Margin="7,0"
                    Command="{Binding IrAProductosCommand}" ToolTip="Ver el catálogo de productos">
                <Button.Tag>
                    <SolidColorBrush Color="#AF52DE" />
                </Button.Tag>
                <Grid>
                    <materialDesign:PackIcon Style="{DynamicResource FlechaTarjeta}" />
                    <StackPanel>
                        <Border Style="{DynamicResource ChipIcono}" Background="#F5EAFB" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="GlassCocktail" Width="20" Height="20" Foreground="#AF52DE"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource NumeroGrande}" Foreground="#AF52DE"
                                   Text="{Binding CantidadProductos}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Productos en catálogo" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{DynamicResource TarjetaAccion}" Margin="7,0"
                    Command="{Binding IrAInventarioCommand}" ToolTip="Ver el inventario de insumos"
                    Tag="{DynamicResource Aviso}">
                <Grid>
                    <materialDesign:PackIcon Style="{DynamicResource FlechaTarjeta}" />
                    <StackPanel>
                        <Border Style="{DynamicResource ChipIcono}" Background="{DynamicResource AvisoSuave}" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20"
                                                     Foreground="{DynamicResource Aviso}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource NumeroGrande}" Foreground="{DynamicResource Aviso}"
                                   Text="{Binding CantidadInsumos}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Insumos en inventario" />
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{DynamicResource TarjetaAccion}" Margin="7,0"
                    Command="{Binding IrAEmpleadosCommand}" ToolTip="Ver el padrón de personas"
                    Visibility="{Binding PuedeVerEmpleados, Converter={StaticResource BoolAVisibilidad}}">
                <Button.Tag>
                    <SolidColorBrush Color="#515154" />
                </Button.Tag>
                <Grid>
                    <materialDesign:PackIcon Style="{DynamicResource FlechaTarjeta}" />
                    <StackPanel>
                        <Border Style="{DynamicResource ChipIcono}" Background="#F2F2F7" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="20" Height="20"
                                                     Foreground="#515154"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource NumeroGrande}" Foreground="#515154"
                                   Text="{Binding CantidadEmpleados}" />
                        <TextBlock Style="{DynamicResource RotuloIndicador}" Text="Empleados" />
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="358" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource PanelAdmin}" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{DynamicResource ChipIconoChico}" Background="{DynamicResource AvisoSuave}">
                            <materialDesign:PackIcon Kind="AlertOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource Aviso}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Alertas de inventario" Style="{DynamicResource TituloEnLinea}" />
                            <TextBlock Text="{Binding TextoAlertas}" Style="{DynamicResource RotuloIndicador}" Margin="0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Alertas}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource SubPanel}" Margin="0,0,0,8"
                                            Background="{DynamicResource AvisoSuave}" BorderBrush="#F3DFC0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0" Kind="AlertCircleOutline"
                                                                     Width="18" Height="18"
                                                                     Foreground="{DynamicResource Aviso}"
                                                                     VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TintaFuerte}" />
                                                <TextBlock FontSize="12" Foreground="#B25000" Margin="0,2,0,0">
                                                    <Run Text="quedan" />
                                                    <Run Text="{Binding Stock, StringFormat={}{0:0.##}, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding UnidadMedida, Mode=OneWay}" />
                                                    <Run Text="· mínimo" />
                                                    <Run Text="{Binding StockMinimo, StringFormat={}{0:0.##}, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{DynamicResource BotonSecundario}"
                                                    Height="32" Padding="12,0" Background="White"
                                                    Foreground="{DynamicResource Aviso}" BorderBrush="#E8C79A"
                                                    Command="{Binding DataContext.ReponerCommand,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <TextBlock>
                                                        <Run Text="Reponer en" />
                                                        <Run Text="{Binding DondeSeRepone, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Button.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PackageUp" Width="15" Height="15"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Reponer" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayAlertas}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource ExitoSuave}"
                                    HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="28" Height="28"
                                                         Foreground="#248A3D"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Todo el inventario está en nivel" Margin="0,14,0,0"
                                       FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TintaFuerte}" HorizontalAlignment="Center" />
                            <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,4,0,0"
                                       Text="Ningún insumo llegó a su punto de reposición." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{DynamicResource ChipIconoChico}" Background="#F5EAFB">
                            <materialDesign:PackIcon Kind="ChartDonut" Width="18" Height="18" Foreground="#AF52DE"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Composición del catálogo" Style="{DynamicResource TituloEnLinea}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource RotuloIndicador}" Margin="0">
                                <Run Text="{Binding CantidadProductos, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="productos en total" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <ProgressBar Style="{DynamicResource BarraProporcion}"
                                 Value="{Binding ProporcionConReceta, Mode=OneWay}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource PuntoLeyenda}"
                                Background="#AF52DE" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Con receta" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ProductosConReceta}" FontSize="22" FontWeight="Bold"
                                       Foreground="#AF52DE" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PorcentajeConReceta}" FontSize="12"
                                       Foreground="{DynamicResource TintaSuave}"
                                       VerticalAlignment="Center" Margin="7,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Descuentan insumos del inventario al venderse."
                                   Style="{DynamicResource TextoAyuda}" Margin="0,2,0,0" />
                    </Grid>

                    <Border Style="{DynamicResource SeparadorEditor}" Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource PuntoLeyenda}"
                                Background="#C7C7CC" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Venta directa" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ProductosDeVentaDirecta}" FontSize="22" FontWeight="Bold"
                                       Foreground="#515154" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PorcentajeVentaDirecta}" FontSize="12"
                                       Foreground="{DynamicResource TintaSuave}"
                                       VerticalAlignment="Center" Margin="7,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Botellas y latas: descuentan su propio stock."
                                   Style="{DynamicResource TextoAyuda}" Margin="0,2,0,0" />
                    </Grid>

                    <Button Style="{DynamicResource BotonPanel}" Margin="0,18,0,0"
                            Command="{Binding IrAProductosCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GlassCocktail" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Administrar catálogo" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

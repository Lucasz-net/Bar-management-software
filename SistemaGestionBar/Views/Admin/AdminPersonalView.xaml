<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminPersonalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="clr-namespace:SistemaGestionBar.Behaviors"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminPersonalViewModel}"
             d:DesignHeight="700" d:DesignWidth="1180">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             LISTA
             ============================================================ -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== BARRA DE ACCIONES Y BÚSQUEDA ====
                 Solo el alta: Editar y Eliminar están al pie de la ficha, en el panel
                 de la derecha, donde se ve a quién afectan. -->
            <Border Grid.Row="0" Style="{DynamicResource PanelAdmin}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Buscador sin marco adentro de la tarjeta, como en el punto de venta -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                                 Foreground="{DynamicResource TintaTenue}"
                                                 VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Grid.Column="1" Style="{DynamicResource BuscadorPlano}"
                                 materialDesign:HintAssist.Hint="Buscar por nombre, apellido, DNI o correo"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Button Grid.Column="1" Style="{DynamicResource BotonPrimario}" Command="{Binding NuevoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Nueva persona" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==== FILTROS ==== -->
            <!-- Los filtros en un WrapPanel y el contador en su propia columna: apilados
                 en la misma celda, al angostar la ventana se montaban uno sobre otro. -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <ListBox Style="{DynamicResource GrupoChips}"
                             DisplayMemberPath="Texto"
                             ItemsSource="{Binding OpcionesVinculo}"
                             SelectedItem="{Binding Vinculo}" />

                    <ComboBox Style="{DynamicResource FiltroCombo}" Margin="6,0,0,0" MinWidth="164"
                              DisplayMemberPath="Texto"
                              ItemsSource="{Binding OpcionesRol}"
                              SelectedItem="{Binding RolFiltro}" />

                    <Button Style="{DynamicResource BotonSecundario}" Margin="8,0,0,0" Padding="11,0"
                            Command="{Binding LimpiarFiltrosCommand}" ToolTip="Quitar todos los filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" />
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Style="{DynamicResource ContadorFiltro}">
                        <Run Text="{Binding CantidadVisible, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="de" />
                        <Run Text="{Binding CantidadTotal, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding CantidadClientes, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="clientes" />
                        <Run Text="·" />
                        <Run Text="{Binding CantidadEmpleados, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="empleados" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{DynamicResource BarraMensaje}" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Style="{DynamicResource IconoMensaje}" />
                    <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
                </StackPanel>
            </Border>

            <!-- ==== GRILLA ==== -->
            <!-- Va en la fila estrella para que arme su propio scroll. -->
            <Border Grid.Row="3" Style="{DynamicResource PanelAdmin}" Padding="8,6,8,10" Margin="0,14,0,0">
                <Grid Style="{DynamicResource ZonaBloqueable}">
                    <DataGrid Style="{DynamicResource GrillaAdmin}"
                              ItemsSource="{Binding Vista}"
                              SelectedItem="{Binding Seleccionada}"
                              b:SelectorAssist.DesplazarASeleccion="True"
                              b:SelectorAssist.SeleccionBloqueada="{Binding EnEdicion}">
                        <DataGrid.Columns>
                            <!-- Identidad: avatar con iniciales + nombre y documento juntos.
                                 Dos datos que siempre se leen de a pares, en una sola celda. -->
                            <DataGridTemplateColumn Header="PERSONA" Width="*" MinWidth="250" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AcentoSuave}">
                                                <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18"
                                                                         Foreground="{DynamicResource Acento}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                                <TextBlock Text="{Binding NombreParaListado}" FontSize="14.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}" />
                                                <TextBlock Text="{Binding DniCuit}" FontSize="12"
                                                           Foreground="{DynamicResource TintaSuave}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="CONTACTO" Width="*" MinWidth="196" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Email, TargetNullValue='—'}" FontSize="13.5"
                                                       Foreground="{DynamicResource TintaFuerte}" />
                                            <TextBlock Text="{Binding Telefono, TargetNullValue='sin teléfono'}" FontSize="12"
                                                       Foreground="{DynamicResource TintaSuave}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ACCESO AL SISTEMA" Width="*" MinWidth="202" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Con cuenta se muestran correo y rol; sin cuenta,
                                             una sola línea que lo dice. Antes los tres
                                             renglones convivían y el alto de fila no
                                             alcanzaba: "sin cuenta" salía cortado. -->
                                        <Grid VerticalAlignment="Center">
                                            <StackPanel Visibility="{Binding EsEmpleado, Converter={StaticResource BoolAVisibilidad}}">
                                                <TextBlock Text="{Binding Usuario.Email}" FontSize="13.5"
                                                           Foreground="{DynamicResource TintaFuerte}" />
                                                <TextBlock Text="{Binding Usuario.NombreRol}" FontSize="12"
                                                           Foreground="{DynamicResource TintaSuave}" />
                                            </StackPanel>
                                            <TextBlock Text="sin cuenta" FontSize="13" FontStyle="Italic"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TintaTenue}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsEmpleado}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="VÍNCULO" Width="190" MinWidth="190" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource AcentoSuave}"
                                                    Visibility="{Binding EsCliente, Converter={StaticResource BoolAVisibilidad}}">
                                                <TextBlock Style="{DynamicResource TextoChip}" Foreground="{DynamicResource Acento}" Text="CLIENTE" />
                                            </Border>
                                            <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource ExitoSuave}"
                                                    Visibility="{Binding EsEmpleado, Converter={StaticResource BoolAVisibilidad}}">
                                                <TextBlock Style="{DynamicResource TextoChip}" Foreground="#17703F" Text="EMPLEADO" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vacío: qué se ve cuando el filtro no deja nada -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CantidadVisible}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="40" Height="40"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,10,0,0"
                                   Text="Ninguna persona coincide con el filtro." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             PANEL DERECHO: FICHA O FORMULARIO
             ============================================================ -->
        <Border Grid.Column="1" Style="{DynamicResource PanelAdmin}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Style="{DynamicResource ChipIconoChico}">
                        <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource Acento}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding TituloEditor}" Style="{DynamicResource TituloEnLinea}" Margin="11,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">

                    <!-- ======== CARA 1: FICHA ======== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" VerticalAlignment="Top">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AcentoSuave}">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="26" Height="26"
                                                             Foreground="{DynamicResource Acento}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock Text="{Binding Seleccionada.NombreCompleto}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource TintaFuerte}" TextWrapping="Wrap" MaxWidth="240" />
                                    <TextBlock Text="{Binding Seleccionada.DniCuit}" FontSize="13"
                                               Foreground="{DynamicResource TintaSuave}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource AcentoSuave}"
                                        Visibility="{Binding Seleccionada.EsCliente, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock Style="{DynamicResource TextoChip}" Foreground="{DynamicResource Acento}" Text="CLIENTE" />
                                </Border>
                                <Border Style="{DynamicResource ChipGrilla}" Background="{DynamicResource ExitoSuave}"
                                        Visibility="{Binding Seleccionada.EsEmpleado, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock Style="{DynamicResource TextoChip}" Foreground="#17703F" Text="EMPLEADO" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="CONTACTO" Style="{DynamicResource TituloBloque}" Margin="0,20,0,10" />
                            <Border Style="{DynamicResource SubPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Correo personal" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionada.Email, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Teléfono" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionada.Telefono, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ACCESO AL SISTEMA" Style="{DynamicResource TituloBloque}" Margin="0,18,0,10" />

                            <!-- Con cuenta: qué correo usa para entrar y con qué rol. -->
                            <Border Style="{DynamicResource SubPanel}"
                                    Visibility="{Binding Seleccionada.EsEmpleado, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Correo de trabajo" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionada.Usuario.Email}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Rol" Style="{DynamicResource RotuloDato}" />
                                        <TextBlock Style="{DynamicResource ValorDato}"
                                                   Text="{Binding Seleccionada.Usuario.NombreRol}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sin cuenta: se dice, no se deja el bloque vacío. -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SubPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Seleccionada.EsEmpleado}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="KeyRemove" Width="16" Height="16"
                                                             Foreground="{DynamicResource TintaSuave}"
                                                             VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Style="{DynamicResource TextoAyuda}" Margin="9,0,0,0" Width="272"
                                               Text="No trabaja en el bar: no tiene cuenta para iniciar sesión." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sin nada elegido y sin formulario abierto -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="36" Height="36"
                                                 Foreground="{DynamicResource Linea}" HorizontalAlignment="Center" />
                        <TextBlock Style="{DynamicResource TextoVacio}" Margin="0,12,0,0"
                                   Text="Elegí una persona de la lista para ver su ficha, editarla o eliminarla." />
                    </StackPanel>

                    <!-- ======== CARA 2: FORMULARIO ======== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                                  Visibility="{Binding EnEdicion, Converter={StaticResource BoolAVisibilidad}}">
                        <StackPanel>

                            <!-- ==== DATOS PERSONALES ==== -->
                            <TextBlock Text="DATOS PERSONALES" Style="{DynamicResource TituloBloque}" />

                            <TextBlock Text="DNI / CUIT" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}"
                                     materialDesign:HintAssist.Hint="Ej: 40.123.456"
                                     Text="{Binding DniCuit, UpdateSourceTrigger=PropertyChanged, Delay=350}" />
                            <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,0">
                                <materialDesign:PackIcon Kind="MagnifyScan" Width="12" Height="12" VerticalAlignment="Center" />
                                <Run Text="Identifica a la persona. Si ya está en el padrón, se cargan sus datos solos." />
                            </TextBlock>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="NOMBRE" Style="{DynamicResource EtiquetaAdmin}" />
                                    <TextBox Style="{DynamicResource CampoAngosto}"
                                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="APELLIDO" Style="{DynamicResource EtiquetaAdmin}" />
                                    <TextBox Style="{DynamicResource CampoAngosto}"
                                             Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="TELÉFONO" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}"
                                     materialDesign:HintAssist.Hint="Ej: 11 5555-4444"
                                     Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="CORREO PERSONAL" Style="{DynamicResource EtiquetaAdmin}" />
                            <TextBox Style="{DynamicResource CampoAdmin}"
                                     materialDesign:HintAssist.Hint="nombre@correo.com"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- ==== CLIENTE ==== -->
                            <Border Style="{DynamicResource SubPanel}" Margin="0,6,0,0">
                                <StackPanel>
                                    <CheckBox FontSize="14" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TintaFuerte}"
                                              IsChecked="{Binding EsCliente}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountHeartOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
                                            <TextBlock Text="Es cliente del bar" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Style="{DynamicResource TextoAyuda}"
                                               Text="Aparece en el combo de clientes del punto de venta." />
                                </StackPanel>
                            </Border>

                            <!-- ==== ACCESO AL SISTEMA ==== -->
                            <Border Style="{DynamicResource SubPanel}" Margin="0,10,0,0">
                                <StackPanel>
                                    <CheckBox FontSize="14" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TintaFuerte}"
                                              IsChecked="{Binding TieneCuenta}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="KeyOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
                                            <TextBlock Text="Trabaja en el bar y entra al sistema" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>

                                    <StackPanel IsEnabled="{Binding TieneCuenta}" Margin="0,12,0,0">
                                        <TextBlock Text="CORREO DE TRABAJO" Style="{DynamicResource EtiquetaAdmin}" />
                                        <TextBox Style="{DynamicResource CampoAdmin}"
                                                 materialDesign:HintAssist.Hint="nombre@bar.com"
                                                 Text="{Binding EmailTrabajo, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,14"
                                                   Text="Es la credencial de inicio de sesión, distinta del correo personal." />

                                        <TextBlock Text="ROL" Style="{DynamicResource EtiquetaAdmin}" />
                                        <ComboBox Style="{DynamicResource ComboAdmin}"
                                                  DisplayMemberPath="NombreRol"
                                                  ItemsSource="{Binding Roles}"
                                                  SelectedItem="{Binding RolSeleccionado}" />
                                        <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,14"
                                                   Text="Vendedor y Mesero tienen las mismas atribuciones: el rol dice el puesto y es lo que se registra al vender en una mesa." />

                                        <TextBlock Text="CONTRASEÑA" Style="{DynamicResource EtiquetaAdmin}" />
                                        <PasswordBox Style="{DynamicResource ClaveAdmin}"
                                                     b:PasswordBoxAssist.Enlazar="True"
                                                     b:PasswordBoxAssist.Password="{Binding ClaveNueva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{DynamicResource TextoAyuda}" Margin="0,0,0,0"
                                                   Text="{Binding AyudaCuenta}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==== PIE DE ACCIONES ==== -->
                <Grid Grid.Row="2">

                    <Grid Margin="0,16,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NoEnEdicion}" Value="True" />
                                            <Condition Binding="{Binding HaySeleccion}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{DynamicResource BotonPanel}" Margin="0,0,5,0"
                                Command="{Binding EditarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Editar" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource BotonPanelPeligro}" Margin="5,0,0,0"
                                Command="{Binding EliminarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Eliminar" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Visibility="{Binding EnEdicion, Converter={StaticResource BoolAVisibilidad}}">
                        <Border Style="{DynamicResource PanelValidacion}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                         Foreground="#A93226" VerticalAlignment="Top" Margin="0,1,9,0" />
                                <TextBlock Style="{DynamicResource AvisoValidacion}" Width="288"
                                           Text="{Binding ResumenDeErrores}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{DynamicResource BotonSecundario}" Content="Cancelar"
                                    Margin="0,0,8,0" Command="{Binding CancelarCommand}" />
                            <Button Style="{DynamicResource BotonExito}" Command="{Binding GuardarCommand}" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Guardar" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

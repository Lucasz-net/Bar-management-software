<UserControl x:Class="SistemaGestionBar.Views.Admin.AdminBackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels.Admin"
             xmlns:beh="clr-namespace:SistemaGestionBar.Behaviors"
             d:DataContext="{d:DesignInstance Type=vm:AdminBackupsViewModel}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             FontFamily="/SistemaGestionBar;component/Assets/Fonts/#Inter">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="FondoTarjeta" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F3F8FF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TarjetaResumen" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FondoTarjeta}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{DynamicResource SombraTarjeta}" />
        </Style>

        <Style x:Key="NumeroResumen" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/SistemaGestionBar;component/Assets/Fonts/#Inter" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        </Style>

        <Style x:Key="RotuloResumen" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="BotonAccionCircular" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="fondo" CornerRadius="19" Background="{TemplateBinding Background}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonRestaurar" TargetType="Button" BasedOn="{StaticResource BotonAccionCircular}">
            <Setter Property="Background" Value="{DynamicResource ExitoSuave}" />
            <Setter Property="ToolTip" Value="Restaurar este backup" />
        </Style>

        <Style x:Key="BotonEliminar" TargetType="Button" BasedOn="{StaticResource BotonAccionCircular}">
            <Setter Property="Background" Value="{DynamicResource PeligroSuave}" />
            <Setter Property="ToolTip" Value="Eliminar archivo" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource TarjetaResumen}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Acento}" CornerRadius="18,0,0,18" />
                    <StackPanel Grid.Column="1" Margin="16,16,16,16">
                        <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18" Foreground="{DynamicResource Acento}" />
                        <TextBlock Text="{Binding CantidadTexto}" Style="{DynamicResource NumeroResumen}" Margin="0,10,0,0" />
                        <TextBlock Text="Copias guardadas" Style="{DynamicResource RotuloResumen}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource TarjetaResumen}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Exito}" CornerRadius="18,0,0,18" />
                    <StackPanel Grid.Column="1" Margin="16,16,16,16">
                        <materialDesign:PackIcon Kind="ClockCheckOutline" Width="18" Height="18" Foreground="{DynamicResource Exito}" />
                        <TextBlock Text="{Binding UltimaCopiaTexto}" Style="{DynamicResource NumeroResumen}" FontSize="17" Margin="0,10,0,0" />
                        <TextBlock Text="Última copia" Style="{DynamicResource RotuloResumen}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource TarjetaResumen}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Aviso}" CornerRadius="18,0,0,18" />
                    <StackPanel Grid.Column="1" Margin="16,16,16,16">
                        <materialDesign:PackIcon Kind="HarddiskPlus" Width="18" Height="18" Foreground="{DynamicResource Aviso}" />
                        <TextBlock Text="{Binding EspacioTotalTexto}" Style="{DynamicResource NumeroResumen}" Margin="0,10,0,0" />
                        <TextBlock Text="Espacio usado en disco" Style="{DynamicResource RotuloResumen}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Column="3" Command="{Binding CrearBackupCommand}" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tarjeta" CornerRadius="18" Background="{DynamicResource Acento}">
                            <Grid Margin="18,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="13" Background="#2E8CF0">
                                    <materialDesign:PackIcon Kind="DatabaseArrowUpOutline" Width="20" Height="20"
                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Crear backup ahora" FontFamily="/SistemaGestionBar;component/Assets/Fonts/#Inter"
                                               FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Copia completa de la base de datos" FontSize="11.5"
                                               Foreground="#C7DBF7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tarjeta" Property="Background" Value="#0066CC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tarjeta" Property="Background" Value="#0058B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource BarraMensaje}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Style="{DynamicResource IconoMensaje}" />
                <TextBlock Style="{DynamicResource TextoMensaje}" Text="{Binding Mensaje}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding HayBackups, Converter={StaticResource BoolAVisibilidad}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="{DynamicResource Linea}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="17" Height="17"
                                             Foreground="{DynamicResource TintaTenue}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{DynamicResource BuscadorPlano}"
                             Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar por motivo, autor o archivo…" />
                </Grid>
            </Border>
            <ComboBox Grid.Column="1" Style="{DynamicResource FiltroCombo}" HorizontalAlignment="Left" Margin="12,0,0,0"
                      MinWidth="230" beh:ComboAssist.Icono="SortCalendarDescending"
                      DisplayMemberPath="Texto"
                      ItemsSource="{Binding OpcionesOrden}"
                      SelectedItem="{Binding Orden}" />
            <TextBlock Grid.Column="1" Style="{DynamicResource ContadorFiltro}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Visibility="{Binding HayBusqueda, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Mostrando {0} de {1}">
                        <Binding Path="CantidadVisible" />
                        <Binding Path="CantidadTotal" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="3">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HayBackups, Converter={StaticResource BoolAVisibilidad}}">
                <ItemsControl ItemsSource="{Binding Vista}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Background="White" BorderThickness="1.5" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsElMasReciente}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Acento}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="14,0,0,14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Linea}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsElMasReciente}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Acento}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="18,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{DynamicResource ChipIconoChico}" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="17" Height="17"
                                                                     Foreground="{DynamicResource Acento}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nombre}" FontFamily="/SistemaGestionBar;component/Assets/Fonts/#Inter"
                                                           FontSize="14.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TintaFuerte}" />
                                                <Border Background="{DynamicResource AcentoSuave}" CornerRadius="7" Padding="7,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding EsElMasReciente, Converter={StaticResource BoolAVisibilidad}}">
                                                    <TextBlock Text="MÁS RECIENTE" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource Acento}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Motivo}" FontSize="13.5" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TintaFuerte}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <materialDesign:PackIcon Kind="CalendarClockOutline" Width="14" Height="14"
                                                                         Foreground="{DynamicResource TintaTenue}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Fecha}" FontSize="12.5" Margin="5,0,0,0"
                                                           Foreground="{DynamicResource TintaSuave}" FontWeight="SemiBold" />
                                                <TextBlock Text="·" FontSize="12.5" Foreground="{DynamicResource TintaTenue}" Margin="8,0" />
                                                <materialDesign:PackIcon Kind="AccountOutline" Width="14" Height="14"
                                                                         Foreground="{DynamicResource TintaTenue}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CreadoPor}" FontSize="12.5" Margin="5,0,0,0"
                                                           Foreground="{DynamicResource TintaSuave}" />
                                                <TextBlock Text="·" FontSize="12.5" Foreground="{DynamicResource TintaTenue}" Margin="8,0" />
                                                <TextBlock Text="{Binding Tamanio}" FontSize="12.5" Foreground="{DynamicResource TintaTenue}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Button Style="{DynamicResource BotonRestaurar}"
                                                Command="{Binding DataContext.RestaurarBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DatabaseArrowDownOutline" Width="18" Height="18" Foreground="{DynamicResource Exito}" />
                                        </Button>
                                        <Button Style="{DynamicResource BotonEliminar}" Margin="4,0,0,0"
                                                Command="{Binding DataContext.EliminarBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="{DynamicResource Peligro}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HayBackups}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AcentoSuave}" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="DatabaseOffOutline" Width="30" Height="30" Foreground="{DynamicResource Acento}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Todavía no hay copias guardadas" FontFamily="/SistemaGestionBar;component/Assets/Fonts/#Inter"
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TintaFuerte}"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="Usá &quot;Crear backup ahora&quot; para guardar la primera copia de la base de datos."
                           Style="{DynamicResource TextoVacio}" Margin="0,6,0,0" MaxWidth="320" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

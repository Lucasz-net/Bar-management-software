<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Estilos de los modales del backup. Los colores (Linea, TintaFuerte) salen de EstilosAdmin. -->

    <Style x:Key="HojaModal" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linea}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="40" ShadowDepth="10" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TituloModal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TintaFuerte}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <LinearGradientBrush x:Key="FondoTarjeta" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F3F8FF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>

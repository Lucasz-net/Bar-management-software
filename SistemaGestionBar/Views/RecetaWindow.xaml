<Window x:Class="SistemaGestionBar.Views.RecetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecetaViewModel}"
        Title="Receta"
        Width="480"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#7B5BD6" Opacity="0.12" BlurRadius="24" ShadowDepth="4" Direction="270" />
        </Border.Effect>

        <StackPanel>

            <!-- Encabezado -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Background="#F1ECFD" CornerRadius="12" Width="44" Height="44">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="22" Height="22"
                                             Foreground="#7B5BD6"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding NombreProducto}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2B3445" />
                    <TextBlock Text="{Binding Categoria}"
                               FontSize="12"
                               Foreground="#8A93A5" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Descripcion}"
                       FontSize="13"
                       Foreground="#5A6577"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <!-- Ingredientes: vienen de Producto_Ingrediente -->
            <TextBlock Text="INGREDIENTES"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#8A93A5"
                       Margin="0,22,0,8" />

            <Border Background="#F7F9FC" CornerRadius="12" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Ingredientes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse Width="6" Height="6" Fill="#7B5BD6" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}"
                                           FontSize="13"
                                           Foreground="#2B3445"
                                           TextWrapping="Wrap"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Preparacion paso a paso (RF-04) -->
            <TextBlock Text="PREPARACIÓN"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#8A93A5"
                       Margin="0,20,0,8" />

            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Instrucciones}"
                           FontSize="13"
                           Foreground="#2B3445"
                           LineHeight="22"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Button Content="CERRAR"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="16"
                    Height="44"
                    FontSize="13"
                    FontWeight="Bold"
                    Background="#7B5BD6"
                    BorderBrush="#7B5BD6"
                    Foreground="White"
                    Cursor="Hand"
                    IsCancel="True"
                    Margin="0,26,0,0" />

        </StackPanel>
    </Border>
</Window>

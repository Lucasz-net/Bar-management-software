<Window x:Class="SistemaGestionBar.Views.RecetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Receta"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Width="380"
            Padding="28"
            Background="White"
            CornerRadius="16">

        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="30" ShadowDepth="6" Direction="270"/>
        </Border.Effect>

        <StackPanel>

            <Grid Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="GlassCocktail"
                                              Width="26"
                                              Height="26"
                                              Foreground="#2D89EF"
                                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtNombreCoctel"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#222222"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888888"
                        FontSize="16"
                        Cursor="Hand"
                        Click="BtnCerrar_Click"/>
            </Grid>

            <TextBlock Text="INGREDIENTES"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="#1565C0"
                       Margin="0,0,0,10"/>

            <ItemsControl x:Name="lstIngredientes" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="5" Height="5" Fill="#2D89EF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="PREPARACIÓN"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="#1565C0"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="txtPreparacion"
                       FontSize="13"
                       Foreground="#333333"
                       TextWrapping="Wrap"
                       LineHeight="20"/>

        </StackPanel>

    </Border>
</Window>

<Window x:Class="SistemaGestionBar.Views.RecetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecetaViewModel}"
        Title="Receta"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Border Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.07" BlurRadius="24" ShadowDepth="4" Direction="270" />
        </Border.Effect>

        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Background="#F5EAFB" CornerRadius="12" Width="44" Height="44">
                    <materialDesign:PackIcon Kind="BookOpenVariant"
                                             Width="22" Height="22"
                                             Foreground="#AF52DE"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding NombreProducto}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#1D1D1F" />
                    <TextBlock Text="{Binding Categoria}"
                               FontSize="13"
                               Foreground="#6E6E73" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Descripcion}"
                       FontSize="14"
                       Foreground="#515154"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <TextBlock Text="INGREDIENTES"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#6E6E73"
                       Margin="0,22,0,8" />

            <Border Background="#F7F7F9" CornerRadius="12" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Ingredientes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Ellipse Width="6" Height="6" Fill="#AF52DE" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}"
                                           FontSize="14"
                                           Foreground="#1D1D1F"
                                           TextWrapping="Wrap"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="PREPARACIÓN"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#6E6E73"
                       Margin="0,20,0,8" />

            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Instrucciones}"
                           FontSize="14"
                           Foreground="#1D1D1F"
                           LineHeight="22"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Button Content="CERRAR"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="16"
                    Height="44"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#AF52DE"
                    BorderBrush="#AF52DE"
                    Foreground="White"
                    Cursor="Hand"
                    IsCancel="True"
                    Margin="0,26,0,0" />

        </StackPanel>
    </Border>
</Window>

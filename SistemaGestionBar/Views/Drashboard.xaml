<UserControl x:Class="SistemaGestionBar.Views.Drashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SistemaGestionBar.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1280"
             Background="#F8F6F1">

    <UserControl.Resources>
        <!-- Estilo de tarjetas de producto -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8E4D9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón + verde -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="18" 
                                Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== ZONA PRINCIPAL (IZQUIERDA) ==================== -->
        <Grid Grid.Column="0" Margin="20,15,10,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Search -->
                <RowDefinition Height="Auto"/>
                <!-- Categorías -->
                <RowDefinition Height="*"/>
                <!-- Productos -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Nombre -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E7D32" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="🍺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SISTEMA BAR" FontWeight="Bold" FontSize="16" Foreground="#1B5E20"/>
                        <TextBlock x:Name="txtFecha" Text="Hoy" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>

                <!-- Total + Botones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="20" Padding="14,8" Margin="0,0,10,0"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <TextBlock x:Name="txtTotalOrdenes" Text="Total : 0 Órdenes" FontSize="13" Foreground="#555"/>
                    </Border>

                    <Button Content="📄  Report" 
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1"
                            Padding="14,8" 
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="BtnReport_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="20" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Notificaciones -->
                    <Border Background="White" CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0"
                            BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#E53935" CornerRadius="8" Width="16" Height="16" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                                <TextBlock Text="1" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Perfil -->
                    <Border Background="#2E7D32" CornerRadius="20" Width="40" Height="40" Cursor="Hand">
                        <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- SEARCH -->
            <Border Grid.Row="1" Background="White" CornerRadius="25" Padding="15,10" Margin="0,0,0,18"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#888"/>
                    <TextBox Grid.Column="1" 
                             x:Name="txtSearch"
                             Text="Search" 
                             Foreground="#AAA"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalAlignment="Center"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"/>
                    <TextBlock Grid.Column="2" Text="⚙️" FontSize="16" VerticalAlignment="Center" Foreground="#888" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- CATEGORÍAS -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,18">
                <!-- Coffee / Cervezas -->
                <Border Background="#1B5E20" CornerRadius="16" Padding="18" Margin="0,0,8,0" Cursor="Hand">
                    <Grid>
                        <StackPanel>
                            <Border Background="#4CAF50" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Available" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Cervezas" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="24 Items" Foreground="#A5D6A7" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🍺" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.25"/>
                    </Grid>
                </Border>

                <!-- Tea / Cócteles -->
                <Border Background="White" CornerRadius="16" Padding="18" Margin="4,0" 
                        BorderBrush="#E0E0E0" BorderThickness="1.5" Cursor="Hand">
                    <Grid>
                        <StackPanel>
                            <Border Background="#E8F5E9" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Available" Foreground="#2E7D32" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Cócteles" Foreground="#333" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="18 Items" Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🍸" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.2"/>
                    </Grid>
                </Border>

                <!-- Snack -->
                <Border Background="White" CornerRadius="16" Padding="18" Margin="8,0,0,0" 
                        BorderBrush="#E0E0E0" BorderThickness="1.5" Cursor="Hand">
                    <Grid>
                        <StackPanel>
                            <Border Background="#FFEBEE" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Need to re-stock" Foreground="#C62828" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Snacks" Foreground="#333" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="12 Items" Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🍟" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.2"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- GRID DE PRODUCTOS -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <UniformGrid Columns="4">
                    <!-- Producto 1 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍺" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Corona Extra" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$4.50" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Corona Extra|4.50"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 2 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍺" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Heineken" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$4.80" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Heineken|4.80"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 3 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍸" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Mojito" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$6.50" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Mojito|6.50"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 4 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍸" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Margarita" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$7.00" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Margarita|7.00"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 5 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🥃" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Whisky Sour" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$8.50" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Whisky Sour|8.50"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 6 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍟" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Papas Fritas" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$3.50" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Papas Fritas|3.50"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 7 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍕" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Nachos" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$5.00" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Nachos|5.00"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 8 -->
                    <Border Style="{StaticResource ProductCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🥤" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Refresco" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$2.50" FontSize="15" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource AddButton}" Content="+" HorizontalAlignment="Right" Click="BtnAdd_Click" Tag="Refresco|2.50"/>
                            </Grid>
                        </Grid>
                    </Border>
                </UniformGrid>
            </ScrollViewer>
        </Grid>

        <!-- ==================== PANEL DERECHO (PEDIDO) ==================== -->
        <Border Grid.Column="1" Background="White" CornerRadius="20,0,0,20" Margin="0,10,0,10"
                BorderBrush="#E8E4D9" BorderThickness="1,0,0,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header pedido -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tipo + Cliente -->
                    <RowDefinition Height="*"/>
                    <!-- Lista de items -->
                    <RowDefinition Height="Auto"/>
                    <!-- Totales + Pagar -->
                </Grid.RowDefinitions>

                <!-- Header del pedido -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Orden Actual" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="#27362" FontSize="13" Foreground="#888" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Tipo de orden + Cliente -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#2E7D32" CornerRadius="20" Padding="16,8" Margin="0,0,8,0" Cursor="Hand">
                            <TextBlock Text="Dine In" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#F5F5F5" CornerRadius="20" Padding="16,8" Cursor="Hand">
                            <TextBlock Text="Take Away" Foreground="#666" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cliente" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <Border Background="#F8F8F8" CornerRadius="10" Padding="10,8">
                                <TextBlock Text="Cliente General" FontSize="13" Foreground="#333"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Mesa" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <Border Background="#F8F8F8" CornerRadius="10" Padding="10,8">
                                <TextBlock Text="Mesa 05" FontSize="13" Foreground="#333"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Lista de productos del pedido -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlOrderItems">
                        <!-- Los items se agregan dinámicamente desde el code-behind -->
                        <TextBlock Text="No hay productos agregados" 
                                   Foreground="#AAA" 
                                   FontSize="13" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,40,0,0"
                                   x:Name="txtEmptyOrder"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Totales + Botón Pagar -->
                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <Border Background="#F8F6F1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" Foreground="#666" FontSize="13"/>
                                <TextBlock x:Name="txtSubtotal" Text="$0.00" Foreground="#333" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Impuesto (16%)" Foreground="#666" FontSize="13"/>
                                <TextBlock x:Name="txtImpuesto" Text="$0.00" Foreground="#333" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,6" Background="#E0E0E0"/>
                            <Grid>
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                                <TextBlock x:Name="txtTotal" Text="$0.00" FontWeight="Bold" FontSize="16" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Pagar  →" 
                            Background="#2E7D32" 
                            Foreground="White" 
                            FontSize="15" 
                            FontWeight="SemiBold"
                            Height="48"
                            Cursor="Hand"
                            Click="BtnPagar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B5E20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
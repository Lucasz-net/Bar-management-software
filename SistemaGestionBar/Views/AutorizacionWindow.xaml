<Window x:Class="SistemaGestionBar.Views.AutorizacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Autorización Requerida"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize">

    <!-- Tarjeta modal con bordes redondeados y sombra suave -->
    <Border Background="White" CornerRadius="16" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.15" Color="#1565C0"/>
        </Border.Effect>

        <StackPanel Margin="24">

            <!-- Encabezado con Ícono -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="ShieldLockOutline" Width="32" Height="32" Foreground="#D32F2F" VerticalAlignment="Center"/>
                <TextBlock Text="Autorización de Supervisor" FontSize="18" FontWeight="SemiBold" Foreground="#2B3445" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Esta acción requiere privilegios de Administrador o Gerente. Ingrese sus credenciales para continuar." 
                       TextWrapping="Wrap" Foreground="#8A93A5" FontSize="14" Margin="0,0,0,24"/>

            <!-- Correo de Supervisor -->
            <TextBox materialDesign:HintAssist.Hint="Correo de trabajo del supervisor"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding EmailSupervisor, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" FontSize="14" Padding="16,12"/>

            <!-- Contraseña del Supervisor -->
            <!-- Se nombra 'txtClave' para enviarlo como parámetro al ViewModel -->
            <PasswordBox x:Name="txtClave"
                         materialDesign:HintAssist.Hint="Contraseña"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,8" FontSize="14" Padding="16,12"/>

            <!-- Panel rojo de error -->
            <TextBlock Text="{Binding MensajeError}" 
           Foreground="#D32F2F" FontSize="13" TextWrapping="Wrap"
           Margin="0,0,0,24">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <!-- Botones de Acción -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCELAR" 
                        Command="{Binding CancelarCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#8A93A5" Margin="0,0,8,0" Height="42" Padding="16,0"/>

                <Button Content="AUTORIZAR" 
                        Command="{Binding ConfirmarCommand}"
                        CommandParameter="{Binding ElementName=txtClave}"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="16" Height="42" Padding="24,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
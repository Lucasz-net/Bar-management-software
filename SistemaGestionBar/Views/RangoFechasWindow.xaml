<Window x:Class="SistemaGestionBar.Views.RangoFechasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Elegir fechas"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">

    <Border Style="{DynamicResource HojaModal}">
        <StackPanel Margin="24">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="CalendarRange" Width="26" Height="26"
                                         Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
                <TextBlock Text="Elegí el período" Style="{DynamicResource TituloModal}" Margin="12,0,0,0" />
            </StackPanel>


            <Border Background="{DynamicResource Fondo}" CornerRadius="14" Padding="8" HorizontalAlignment="Center">
                <Calendar x:Name="Calendario" SelectionMode="SingleRange"
                          SelectedDatesChanged="AlCambiarSeleccion" />
            </Border>

            <Border Background="{DynamicResource AcentoSuave}" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
                <TextBlock Text="{Binding Resumen}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Acento}" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Style="{DynamicResource BotonSecundario}" Margin="0,0,10,0" />
                <Button Content="Aplicar" Command="{Binding AplicarCommand}"
                        Style="{DynamicResource BotonPrimario}" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

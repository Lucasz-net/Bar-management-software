<Window x:Class="SistemaGestionBar.Views.ElegirImagenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Elegir imagen"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize">

    <Border Style="{DynamicResource HojaModal}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="26" Height="26"
                                             Foreground="{DynamicResource Acento}" VerticalAlignment="Center" />
                    <TextBlock Text="Elegí una imagen" Style="{DynamicResource TituloModal}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Opciones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="136" Margin="0,0,10,10" Cursor="Hand"
                                    Command="{Binding DataContext.ElegirCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tarjeta" CornerRadius="14" Padding="6" Background="White"
                                                BorderThickness="2" BorderBrush="{DynamicResource Linea}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tarjeta" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <Border Height="104" CornerRadius="10" Background="{DynamicResource Fondo}" ClipToBounds="True">
                                        <Image Source="{Binding Ruta}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TintaFuerte}" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,7,0,2" />
                                    <TextBlock Text="Actual" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Acento}" TextAlignment="Center"
                                               Visibility="{Binding EsActual, Converter={StaticResource BoolAVisibilidad}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button Content="Quitar imagen" Command="{Binding QuitarCommand}"
                        Style="{DynamicResource BotonSecundario}" HorizontalAlignment="Left" />
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Style="{DynamicResource BotonSecundario}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</Window>

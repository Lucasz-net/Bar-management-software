<UserControl x:Class="SistemaGestionBar.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SistemaGestionBar.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1280"
             Background="#F8F6F1">

    <UserControl.Resources>
        <!-- Estilo de tarjetas de producto -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8E4D9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="205"/>
            <Setter Property="Height" Value="195"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Botón + celeste (agregar) -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#2D89EF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón − gris (bajar cantidad) -->
        <Style x:Key="MinusButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== ZONA PRINCIPAL (IZQUIERDA) ==================== -->
        <Grid Grid.Column="0" Margin="20,15,10,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Search -->
                <RowDefinition Height="Auto"/>
                <!-- Categorías -->
                <RowDefinition Height="*"/>
                <!-- Productos -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Nombre -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2D89EF" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="🍺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SISTEMA BAR" FontWeight="Bold" FontSize="16" Foreground="#1565C0"/>
                        <TextBlock x:Name="txtFecha" Text="Hoy" FontSize="12" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>

                <!-- Total + Botones -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="20" Padding="14,8" Margin="0,0,10,0"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <TextBlock x:Name="txtTotalOrdenes" Text="Total : 0 Órdenes" FontSize="13" Foreground="#555"/>
                    </Border>

                    <Button Content="📄  Reporte"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Padding="14,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Click="BtnReport_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Notificaciones -->
                    <Border Background="White" CornerRadius="20" Width="40" Height="40" Margin="0,0,8,0"
                            BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#E53935" CornerRadius="8" Width="16" Height="16"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                                <TextBlock Text="1" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Perfil -->
                    <StackPanel Orientation="Horizontal" Cursor="Hand">
                        <TextBlock x:Name="txtNombreVendedor"
                                   Text="Vendedor"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#333"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Border Background="#2D89EF" CornerRadius="20" Width="40" Height="40">
                            <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SEARCH -->
            <Border Grid.Row="1" Background="White" CornerRadius="25" Padding="15,10" Margin="0,0,0,18"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#888"/>
                    <TextBox Grid.Column="1"
                             x:Name="txtSearch"
                             Text="Buscar"
                             Foreground="#AAA"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalAlignment="Center"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"/>
                    <TextBlock Grid.Column="2" Text="⚙️" FontSize="16" VerticalAlignment="Center" Foreground="#888" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- CATEGORÍAS -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,18">
                <!-- Bebidas -->
                <Border x:Name="borderCatBebidas" Background="White" CornerRadius="16" Padding="18" Margin="0,0,8,0"
                        BorderBrush="#E0E0E0" BorderThickness="1.5" Cursor="Hand"
                        Tag="Bebidas" MouseLeftButtonUp="Categoria_Click">
                    <Grid>
                        <StackPanel>
                            <Border Background="#E3F2FD" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Disponible" Foreground="#2D89EF" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="txtTituloCatBebidas" Text="Bebidas" Foreground="#333" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCantidadCatBebidas" Text="2 Items" Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🍺" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.2"/>
                    </Grid>
                </Border>

                <!-- Cócteles -->
                <Border x:Name="borderCatCocteles" Background="White" CornerRadius="16" Padding="18" Margin="4,0"
                        BorderBrush="#E0E0E0" BorderThickness="1.5" Cursor="Hand"
                        Tag="Cócteles" MouseLeftButtonUp="Categoria_Click">
                    <Grid>
                        <StackPanel>
                            <Border Background="#E3F2FD" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Disponible" Foreground="#2D89EF" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="txtTituloCatCocteles" Text="Cócteles" Foreground="#333" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCantidadCatCocteles" Text="3 Items" Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🍸" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.2"/>
                    </Grid>
                </Border>

                <!-- Bebidas sin alcohol -->
                <Border x:Name="borderCatSinAlcohol" Background="White" CornerRadius="16" Padding="18" Margin="8,0,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="1.5" Cursor="Hand"
                        Tag="Bebidas sin alcohol" MouseLeftButtonUp="Categoria_Click">
                    <Grid>
                        <StackPanel>
                            <Border Background="#E3F2FD" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="Disponible" Foreground="#2D89EF" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="txtTituloCatSinAlcohol" Text="Bebidas sin alcohol" Foreground="#333" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtCantidadCatSinAlcohol" Text="3 Items" Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Text="🥤" FontSize="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.2"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- GRID DE PRODUCTOS -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="pnlProductos">
                    <!-- Producto 1 -->
                    <Border x:Name="cardCoronaExtra" Style="{StaticResource ProductCard}" Tag="Corona Extra|4.50|Bebidas" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍺" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Corona Extra" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$4.50" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusCoronaExtra" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Corona Extra" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyCoronaExtra" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Corona Extra|4.50"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 2 -->
                    <Border x:Name="cardHeineken" Style="{StaticResource ProductCard}" Tag="Heineken|4.80|Bebidas" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍺" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Heineken" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$4.80" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusHeineken" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Heineken" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyHeineken" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Heineken|4.80"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 3 -->
                    <Border x:Name="cardMojito" Style="{StaticResource ProductCard}" Tag="Mojito|6.50|Cócteles" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Background="#F5F5F5" CornerRadius="10" Height="100">
                                    <TextBlock Text="🍸" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="Receta" FontSize="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                        Background="White" BorderBrush="#2D89EF" BorderThickness="1" Foreground="#2D89EF" Cursor="Hand"
                                        Click="BtnReceta_Click" Tag="Mojito">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Mojito" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$6.50" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusMojito" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Mojito" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyMojito" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Mojito|6.50"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 4 -->
                    <Border x:Name="cardMargarita" Style="{StaticResource ProductCard}" Tag="Margarita|7.00|Cócteles" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Background="#F5F5F5" CornerRadius="10" Height="100">
                                    <TextBlock Text="🍸" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="Receta" FontSize="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                        Background="White" BorderBrush="#2D89EF" BorderThickness="1" Foreground="#2D89EF" Cursor="Hand"
                                        Click="BtnReceta_Click" Tag="Margarita">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Margarita" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$7.00" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusMargarita" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Margarita" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyMargarita" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Margarita|7.00"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 5 -->
                    <Border x:Name="cardWhiskySour" Style="{StaticResource ProductCard}" Tag="Whisky Sour|8.50|Cócteles" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Border Background="#F5F5F5" CornerRadius="10" Height="100">
                                    <TextBlock Text="🥃" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Content="Receta" FontSize="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                        Background="White" BorderBrush="#2D89EF" BorderThickness="1" Foreground="#2D89EF" Cursor="Hand"
                                        Click="BtnReceta_Click" Tag="Whisky Sour">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Whisky Sour" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$8.50" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusWhiskySour" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Whisky Sour" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyWhiskySour" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Whisky Sour|8.50"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 6 -->
                    <Border x:Name="cardLimonada" Style="{StaticResource ProductCard}" Tag="Limonada|3.00|Bebidas sin alcohol" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🍋" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Limonada" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$3.00" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusLimonada" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Limonada" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyLimonada" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Limonada|3.00"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 7 -->
                    <Border x:Name="cardAguaMineral" Style="{StaticResource ProductCard}" Tag="Agua Mineral|2.00|Bebidas sin alcohol" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="💧" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Agua Mineral" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$2.00" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusAguaMineral" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Agua Mineral" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyAguaMineral" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Agua Mineral|2.00"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Producto 8 -->
                    <Border x:Name="cardRefresco" Style="{StaticResource ProductCard}" Tag="Refresco|2.50|Bebidas sin alcohol" MouseLeftButtonUp="ProductoCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Height="100" Margin="0,0,0,10">
                                <TextBlock Text="🥤" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="Refresco" FontWeight="SemiBold" FontSize="14" Foreground="#333"/>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="$2.50" FontSize="15" FontWeight="Bold" Foreground="#2D89EF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnMinusRefresco" Style="{StaticResource MinusButton}" Content="−" Margin="0,0,6,0" Click="BtnMinus_Click" Tag="Refresco" Visibility="Collapsed"/>
                                    <TextBlock x:Name="txtQtyRefresco" Text="0" FontSize="14" FontWeight="Bold" Foreground="#333" Width="18" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource AddButton}" Content="+" Click="BtnAdd_Click" Tag="Refresco|2.50"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== PANEL DERECHO (PEDIDO) ==================== -->
        <Border Grid.Column="1" Background="#ECEAE3" CornerRadius="20,0,0,20" Margin="0,10,0,10"
                BorderBrush="#E8E4D9" BorderThickness="1,0,0,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header pedido -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tipo + Cliente -->
                    <RowDefinition Height="*"/>
                    <!-- Lista de items -->
                    <RowDefinition Height="Auto"/>
                    <!-- Totales + Pagar -->
                </Grid.RowDefinitions>

                <!-- Header del pedido -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Orden Actual" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="#27362" FontSize="13" Foreground="#888" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Tipo de orden + Cliente -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#2D89EF" CornerRadius="20" Padding="16,8" Margin="0,0,8,0" Cursor="Hand">
                            <TextBlock Text="En Mesa" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#F5F5F5" CornerRadius="20" Padding="16,8" Cursor="Hand">
                            <TextBlock Text="Para Llevar" Foreground="#666" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cliente" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <Border Background="#F8F8F8" CornerRadius="10" Padding="10,8">
                                <TextBlock Text="Cliente General" FontSize="13" Foreground="#333"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Mesa" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbMesa"
                                      FontSize="13"
                                      Padding="10,6"
                                      Background="#F8F8F8"
                                      BorderThickness="0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Mesa 1"/>
                                <ComboBoxItem Content="Mesa 2"/>
                                <ComboBoxItem Content="Mesa 3"/>
                                <ComboBoxItem Content="Mesa 4"/>
                                <ComboBoxItem Content="Mesa 5"/>
                                <ComboBoxItem Content="Barra"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Lista de productos del pedido -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlOrderItems">
                        <!-- Los items se agregan dinámicamente desde el code-behind -->
                        <TextBlock Text="No hay productos agregados"
                                   Foreground="#AAA"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"
                                   x:Name="txtEmptyOrder"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Totales + Botón Pagar -->
                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <Border Background="#E0DDD2" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal" Foreground="#666" FontSize="13"/>
                                <TextBlock x:Name="txtSubtotal" Text="$0.00" Foreground="#333" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,6" Background="#CFCBBE"/>
                            <Grid>
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="15" Foreground="#333"/>
                                <TextBlock x:Name="txtTotal" Text="$0.00" FontWeight="Bold" FontSize="16" Foreground="#2D89EF" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Pagar  →"
                            Background="#2D89EF"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Height="48"
                            Cursor="Hand"
                            Click="BtnPagar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1565C0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SistemaGestionBar</RootNamespace>
  </PropertyGroup>

  <!-- Las fotos de producto se compilan dentro del ensamblado (Build Action = Resource),
       por eso Producto.RutaImagen puede ser una ruta relativa tipo /Assets/Productos/x.png -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.jpg" />
  </ItemGroup>

  <!-- La cadena de conexion viaja junto al .exe, como haria un appsettings.json.
       El archivo .local lleva la contrasena de cada uno y esta en el .gitignore, por eso
       la condicion: en una copia recien clonada todavia no existe y el build no debe fallar. -->
  <ItemGroup>
    <None Update="conexion.ejemplo.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="conexion.local.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('conexion.local.txt')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>

</Project>

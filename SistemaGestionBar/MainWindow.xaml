<Window x:Class="SistemaGestionBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SistemaGestionBar.ViewModels"
        Title="Sistema de Gestión de Bar"
        Height="820"
        Width="1360"
        MinHeight="740"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F7">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <ContentControl Content="{Binding VistaActual}" />

</Window>
